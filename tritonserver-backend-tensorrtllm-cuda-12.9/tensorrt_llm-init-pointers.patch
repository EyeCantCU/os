Author: James Page <james.page@chainguard.dev>
Date:   Thu Nov 20 14:30:29 2025 +0000

    Fix crash in TrtGptModelInflightBatching due to uninitialized algorithm objects
    
    Initialize five algorithm unique_ptr members that were previously left
    uninitialized, causing null pointer dereference crashes during inference:
    
    - mHandleContextLogits
    - mHandleGenerationLogits
    - mLogitsPostProcessor
    - mMakeDecodingBatchInputOutput
    - mUpdateDecoderBuffers
    
    The crash manifested as an assertion failure in unique_ptr::operator*()
    when decoderStepAsync() attempted to invoke these algorithms. These
    objects follow the same initialization pattern as other algorithm members
    (mPauseRequests, mAssignReqSeqSlots, etc.) and are required for proper
    decoder operation.

diff --git a/cpp/tensorrt_llm/batch_manager/trtGptModelInflightBatching.cpp b/cpp/tensorrt_llm/batch_manager/trtGptModelInflightBatching.cpp
index be7397182..d7454de37 100644
--- a/cpp/tensorrt_llm/batch_manager/trtGptModelInflightBatching.cpp
+++ b/cpp/tensorrt_llm/batch_manager/trtGptModelInflightBatching.cpp
@@ -450,6 +450,11 @@ TrtGptModelInflightBatching::TrtGptModelInflightBatching(std::shared_ptr<nvinfer
 
     mCreateNewDecoderRequests = std::make_unique<CreateNewDecoderRequests>(
         mSpeculativeDecodingFastLogits, mIsLeaderInOrchMode, isNormalizeLogProbs());
+    mHandleContextLogits = std::make_unique<HandleContextLogits>();
+    mHandleGenerationLogits = std::make_unique<HandleGenerationLogits>();
+    mLogitsPostProcessor = std::make_unique<LogitsPostProcessor>();
+    mMakeDecodingBatchInputOutput = std::make_unique<MakeDecodingBatchInputOutput>();
+    mUpdateDecoderBuffers = std::make_unique<UpdateDecoderBuffers>();
 
     TLLM_LOG_TRACE("%s stop", __PRETTY_FUNCTION__);
 }
