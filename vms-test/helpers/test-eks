#!/usr/bin/env bash
# shellcheck disable=SC2015,SC2039,SC2166,SC3043,SC2317,SC2329
VERBOSITY=0
TEMP_D=""
DEF_VERSION="1.32"
DEF_CLUSTER_NAME=vmtest-VERSION
DEF_NODE_TYPE_ARM="t4g.large"
DEF_NODE_TYPE_X86="t3.large"
DEF_NGNAME="burrito"
DEF_AWS_REGION=us-west-1
AWS_REGION=${AWS_REGION:-$DEF_AWS_REGION}

TEARDOWN_NODEGROUP=""
CLUSTER_NAME=""

stderr() { echo "$@" 1>&2; }
failrc() { local rc=$1; shift; stderr "$@"; exit "$rc"; }
fail() { local r=$?;  [ "$r" -eq 0 ] && r=1; failrc "$r" "$@"; }

parse_awspubins() {
    local i="" f="" n=0
    for i in "$@"; do
        if [ -d "$i" ]; then
            for f in "$i"/*.json; do
                dump_awspubin "$f" || { stderr "failed reading $f in $i"; return 1; }
                n=$((n+1))
            done
        elif [ -f "$i" ]; then
            dump_awspubin "$i" || { stderr "failed reading $f"; return 1; }
            n=$((n+1))
        else
            stderr "$f: not a file"
            return 1
        fi
    done
    [ "$n" -ne 0 ] || { stderr "did not process any files"; return 1; }
    return 0
}

Usage_dump_awspubin() {
    cat <<EOF
Usage: ${0##*/} dump-awspubin awspubfile

   Parse an awspub JSON file and output AMI information.

   arguments:
      awspubfile               awspub JSON file to parse

   output format: region ami-id architecture family localname

   where:
      - region: AWS region (e.g. us-east-1)
      - ami-id: AMI ID (e.g. ami-01234678abcdef)
      - architecture: aarch64 or x86_64
      - family: image family (e.g. chainguard-docker-dev)
      - localname: (e.g. aws-docker-dev)

EOF
}

dump_awspubin() {
    local f="$1" out="" arch="" localname=""
    out=$(jq -r '.images | to_entries[] | . as $entry | $entry.value |
        to_entries[] | "\(.key) \(.value) \($entry.key)"' < "$f")
    localname="${f##*/}"
    localname="${localname/.json/}"
    # shellcheck disable=SC2162
    echo "$out" |
        while read region ami name ; do
            # 'name' looks like chainguard-docker-x86_64-20250501-1545
            case "$name" in
                *-arm64-*)
                    arch=aarch64
                    family=${name%-arm64-*}
                    ;;
                *-x86_64-*)
                    arch=x86_64
                    family=${name%-x86_64-*}
                    ;;
                *) stderr "could not find arch in $name"; return 1;;
            esac
            echo "$region $ami $arch $family $localname"
        done
}

Usage_get_pubin_region_ami() {
    cat <<EOF
Usage: ${0##*/} get-pubin-region-ami awspubfile...

   Extract region name and AMI ID for the eks-X.Y-dev image in the awspub files.

   arguments:
      awspubfile               one or more paths to awspub JSON files or
                               directories containing awspub outputs

   environment:
      AWS_REGION               AWS region (default: $DEF_AWS_REGION)

   output format: region ami-id

   where:
      - region: AWS region (e.g. us-east-1)
      - ami-id: AMI ID (e.g. ami-0123456789abcdef)

   Fails if there is not exactly one eks-X.Y-dev AMI.

EOF
}

get_pubin_region_ami() {
    local pfile
    tmpf && pfile="$_RET" || return 1
    parse_awspubins "$@" > "$pfile" ||
        { stderr "Failed to parse aws pubins '$*'"; return 1; }
    local region ami arch family localname found="" fregion=""
    # shellcheck disable=SC2162
    while read region ami arch family localname; do
        case "$family" in
            # match eks-X.Y-dev
            *eks-[0-9].[0-9]*-dev)
                if [[ -n "$AWS_REGION" ]] && [[ "$region" != "$AWS_REGION" ]]; then
                    stderr "ignoring $ami ($family) in $region because of AWS_REGION=$AWS_REGION being set"
                    continue
                fi
                [ -z "$found" ] || {
                    stderr "found more than one eks-X.Y-dev ami in aws pub input $*"
                    return 1
                }
                found="$ami"
                fregion="$region"
                ;;
        esac
    done < "$pfile"
    echo "$fregion $found"
    return 0
}

bad_Usage() {
    local n="$1";
    shift;
    "Usage_${n}" 1>&2;
    [ $# -eq 0 ] || stderr "$@";
    return
}

cleanup() {
    if [ -n "$CLUSTER_NAME" ] && [ -n "$TEARDOWN_NODEGROUP" ]; then
        nodegroup_destroy "$CLUSTER_NAME" "$TEARDOWN_NODEGROUP"
    fi
    [ -z "${TEMP_D}" -o ! -d "${TEMP_D}" ] || rm -Rf "${TEMP_D}"
}

log() {
    local now=""
    now=$(date '+%Y/%m/%d %H:%M:%S')
    [ -z "$LOG" ] || echo "$now" "$@" >> "$LOG"
    stderr "$now" "$@"
}

debug() {
    [ "$VERBOSITY" -ge 1 ] || return 0
    log "[DEBUG]" "$@"
}

# vr(cmd) - run cmd, log execution and result. stdout and stderr unmodified.
vr() {
    local rc="" sstart=$SECONDS
    log "execute: $*"
    "$@"
    rc=$?
    log ":: exit $rc [$((SECONDS-sstart))s]"
    return "$rc"
}

# vrl(output, cmd) - verbose run log.
#   run cmd with output to output.stdout and output.stderr
vrl() {
    local output="$1" rc="" sstart=$SECONDS
    shift
    log "execute: $*"
    "$@" >"$output.stdout" 2>"$output.stderr"
    rc=$?
    log ":: exit $rc [$((SECONDS-sstart))s]"
    return "$rc"
}

# rq(cmd) - run cmd quietly unless it fails
rq() {
    local rc="" out=""
    out=$("$@" 2>&1) && return 0
    rc=$?
    stderr "failed [$rc]: $*"
    printf "%s\n" "$out" | sed -e 's,^,> ,' 1>&2
    return "$rc"
}

Usage_cluster_list() {
    cat <<EOF
Usage: ${0##*/} cluster-list

   List all EKS clusters in the current region.

   environment:
      AWS_REGION               AWS region (default: $DEF_AWS_REGION)

   output: space-separated list of cluster names

EOF
}

cluster_list() {
    local out="" clusters=""
    out=$(eksctl get cluster --output=json --region="$AWS_REGION") ||
        { stderr "cluster_list failed $?"; return 1; }
    clusters=$(echo "$out"  | jq -r '.[].Name') ||
        { stderr "cluster_list output non-json"; return 1; }
    # shellcheck disable=SC2086
    set -- $clusters
    echo "$@"
}

Usage_cluster_status() {
    cat <<EOF
Usage: ${0##*/} cluster-status cluster-name

   Get the status of an EKS cluster.

   arguments:
      cluster-name             name of the EKS cluster

   environment:
      AWS_REGION               AWS region (default: $DEF_AWS_REGION)

   output:
      - ACTIVE: cluster is running
      - CREATING: cluster is being created
      - DELETING: cluster is being deleted
      - FAILED: cluster creation/update failed
      - UPDATING: cluster is being updated
      - PENDING: cluster is not connected to AWS
      - NONE: cluster does not exist

EOF
}

cluster_status() {
    local name="$1" out="" clusters="" status=""
    [ -n "$name" ] || { stderr "cluster_status got empty name"; return 1; }
    clusters=$(cluster_list) || return 1
    case " $clusters " in
        (*\ $name\ *) :;;
        (*) echo "NONE"; return;;
    esac
    out=$(eksctl get cluster --output=json --region="$AWS_REGION" --name="$name") ||
        { stderr "cluster_status --name=$name returned $?"; return 1; }

    status=$(echo "$out" | jq -r '.[].Status') ||
        { stderr "cluster --name=$name returned non-json"; return 1; }
    echo "$status"
}

Usage_cluster_create() {
    cat <<EOF
Usage: ${0##*/} cluster-create cluster-name version

   Create an EKS cluster.

   arguments:
      cluster-name             name of the EKS cluster (e.g. cluster-132)
      version                  Kubernetes version (e.g. 1.32)

   environment:
      AWS_REGION               AWS region (default: $DEF_AWS_REGION)

EOF
}

cluster_create() {
    local name="$1" version="$2"
    vr eksctl create cluster \
       --region="$AWS_REGION" \
       --name="$name" \
       --version="$version" \
       --tags="Environment=wolfi-vm-test" \
       --with-oidc \
       --without-nodegroup \
       --vpc-nat-mode=Disable
}

Usage_cluster_create_if_needed() {
    cat <<EOF
Usage: ${0##*/} cluster-create-if-needed cluster-name version

   Create an EKS cluster if it does not already exist.

   arguments:
      cluster-name             name of the EKS cluster (e.g. cluster-132)
      version                  Kubernetes version (e.g. 1.32)

   environment:
      AWS_REGION               AWS region (default: $DEF_AWS_REGION)

   Fails if a cluster with that name already exists but its status is not ACTIVE.
EOF
}

cluster_create_if_needed() {
    local name="$1" version="$2" status=""
    status=$(cluster_status "$name") ||
        { stderr "Failed to get cluster status"; return 1; }
    case "$status" in
        NONE) cluster_create "$name" "$version" ||
            { stderr "Failed to create cluster $name"; return 1; };;
        ACTIVE) stderr "Re-using existing cluster $name";;
        *) stderr "Cluster $name is in status '$status'. Not sure what to do"
            return 1;;
    esac
}

Usage_cluster_destroy() {
    cat <<EOF
Usage: ${0##*/} cluster-destroy cluster-name

   Destroy an EKS cluster and all associated resources.

   arguments:
      cluster-name             name of the EKS cluster to destroy (e.g. cluster-132)

   environment:
      AWS_REGION               AWS region (default: $DEF_AWS_REGION)

EOF
}

cluster_destroy() {
    local name="$1"
    vr eksctl delete cluster --region="$AWS_REGION" --name="$name"
}

Usage_nodegroup_create() {
    cat <<EOF
Usage: ${0##*/} nodegroup-create cluster nodegroup-name capacity nodetype ami [pubkey]

   Create a node group in an existing EKS cluster.

   arguments:
      cluster                  name of the EKS cluster (e.g. cluster-132)
      nodegroup-name           name for the new nodegroup (e.g. cluster-132-ng)
      capacity                 number of nodes to create (default: 2)
      nodetype                 EC2 instance type (e.g. t4g.large)
      ami                      AMI ID to use for nodes (e.g. ami-012346789abcdef)
      pubkey                   (optional) SSH public key or path to public key file

   environment:
      AWS_REGION               AWS region (default: $DEF_AWS_REGION)

   The node group is created with:
      - Node label: nodegroup=<nodegroup-name>
      - AMI family: AmazonLinux2023

EOF
}

nodegroup_create() {
    local cluster="$1" name="$2" capacity="$3" nodetype="$4" ami="$5"
    local pubkey="$6" pubkeydata=""
    [ $# -eq 5 -o $# -eq 6 ] || {
        stderr "nodegroup_create got $# params. expect 5 or 6"
        stderr "   cluster, nodegroup-name, capacity, nodetype, ami, [pubkey]"
        return 1
    }

    if [ -n "$pubkey" ]; then
        pubkeydata="$pubkey"
        if [ -f "$pubkey" ]; then
            # shellcheck disable=SC2162
            read pubkeydata < "$pubkey" ||
                { stderr "failed reading public key from $pubkey"; }
        fi
        case "$pubkeydata" in
            ssh-ecdsa*|ssh-ed25519*|ssh-rsa*) :;;
            *) stderr "pubkey $pubkey does not look like public key"
                return 1;;
        esac
    fi

    vr eksctl create nodegroup --region="$AWS_REGION" \
        --cluster="$cluster" \
        --name="$name" \
        --node-labels="nodegroup=$name" \
        --nodes="$capacity" \
        --node-ami="$ami" \
        --node-ami-family="AmazonLinux2023" \
        --node-type="$nodetype" \
        ${pubkeydata:+--ssh-public-key="$pubkeydata"}
}

Usage_nodegroup_destroy() {
    cat <<EOF
Usage: ${0##*/} nodegroup-destroy cluster nodegroup-name

   Destroy a node group in an EKS cluster.

   arguments:
      cluster                  name of the EKS cluster (e.g. cluster-132)
      nodegroup-name           name of the node group to destroy (e.g. cluster-132-ng)

   environment:
      AWS_REGION               AWS region (default: $DEF_AWS_REGION)

EOF
}

nodegroup_destroy() {
    local cluster="$1" ngname="$2"
    vr eksctl delete nodegroup --region="$AWS_REGION" \
         --disable-eviction --cluster="$cluster" --name="$ngname"
}

Usage_ami_list() {
    cat <<EOF
Usage: ${0##*/} ami-list [pattern]

   List AMIs matching the specified pattern.

   arguments:
      pattern                  (optional) regex pattern to match AMI names
                               (default: 'chainguard-eks-[0-9][.][0-9]+-dev')

   environment:
      AWS_REGION               AWS region (default: $DEF_AWS_REGION)

   output format: ami-id ami-name

EOF
}

ami_list() {
    local match=${1:-'chainguard-eks-[0-9][.][0-9]+-dev'}
    tmpf && tfile="$_RET" || return 1
    aws ec2 describe-images --region="$AWS_REGION" --executable-users=self > "$tfile" ||
        { rm -f "$tfile"; stderr "describe-images returned $?"; return 1; }

    jq -r '.Images[] | select(.Name? | match("'"$match"'")) | "\(.ImageId) \(.Name)"' < "$tfile" | sort -k2 ||
        { rm -f "$tfile"; stderr "failed jq"; return 1; }
    rm -f "$tfile"
}

Usage_cluster_kubeconfig() {
    cat <<EOF
Usage: ${0##*/} cluster-kubeconfig cluster-name

   Output kubeconfig for the specified EKS cluster to stdout for use with kubectl.

   arguments:
      cluster-name             name of the EKS cluster (e.g. cluster-132)

   environment:
      AWS_REGION               AWS region (default: $DEF_AWS_REGION)

EOF
}

cluster_kubeconfig() {
    local cluster="$1" tmpf=""
    tmpf=$(mktemp) || { stderr "mktemp failed"; return 1; }
    rq eksctl utils write-kubeconfig \
       --cluster="$cluster" --region="$AWS_REGION" --kubeconfig="$tmpf" || {
           rm -f "$tmpf";
           stderr "eksctl utils write-kubeconfig failed";
           return 1;
       }
    cat "$tmpf"
    rm -f "$tmpf"
}

Usage_run_test() {
    cat <<EOF
Usage: ${0##*/} [ options ] out-dir

   Test an EKS AMI (including cluster setup if needed).

   options:

      --cluster-name  NAME     name of the cluster to run tests in (will be
                               created if it does not exist, default: $DEF_CLUSTER_NAME)
      --nodegroup-name NAME    name of the node group to use (will be created
                               with the given AMI and instance type, default: $DEF_NGNAME)

      --version       VER      Kubernetes version of the cluster (default: $DEF_VERSION)

      --awspub-inputs DIR      read awspub info from DIR
      --ami           AMI-ID   AMI ID (conflicts with --awspub-inputs)

      --node-type     TYPE     EC2 instance type to test on (default: $DEF_NODE_TYPE_ARM (aarch64)
                               or $DEF_NODE_TYPE_X86 (x86_64))

      --no-teardown            do not tear down the node group after testing

   arguments:

   environment:
      AWS_REGION               AWS region (default: $DEF_AWS_REGION)

   Either --awspub-inputs or --ami must be provided (but not both).

EOF
}

run_test() {
    local short_opts="hi:I:v"
    local long_opts="ami-id:,awspub-inputs:,help,cluster-name:,node-type:,nodegroup-name:,no-teardown,verbose,version:"
    local getopt_out=""
    getopt_out=$(getopt --name "${0##*/}" \
        --options "${short_opts}" --long "${long_opts}" -- "$@") &&
        eval set -- "${getopt_out}" ||
        { bad_Usage run_test; return; }

    local cur="" next=""
    local cluster="${DEF_CLUSTER_NAME}" nodetype=""
    local version="${DEF_VERSION}" ngname="${DEF_NGNAME}"
    local amiid="" pubin="" outd="" teardown=true

    while [ $# -ne 0 ]; do
        { cur="$1"; next="$2"; }
        case "$cur" in
            -h|--help) Usage_run_test ; exit 0;;
               --cluster-name) cluster=$next; shift;;
               --nodegroup-name) ngname=$next; shift;;
               --no-teardown) teardown=false;;
               --version) version=$next; shift;;
            -v|--verbose) VERBOSITY=$((VERBOSITY+1));;
            -I|--awspub-inputs) pubin="$next"; shift;;
            -i|--ami-id) amiid="$next"; shift;;
            --node-type) nodetype="$next"; shift;;
            --) shift; break;;
        esac
        shift;
    done

    [ $# -eq 1 ] || { bad_Usage run_test "got $# args [$*], expected 1"; return 1; }
    outd="$1"
    shift

    TEMP_D=$(mktemp -d "${TMPDIR:-/tmp}/${0##*/}.XXXXXX") ||
        { stderr "mktemp failed"; return 1; }
    trap cleanup EXIT
    LOG="$outd/test-eks.log"

    if [ -z "$amiid" ] && [ -z "$pubin" ]; then
        bad_Usage run_test "Must give --ami-id or --awspub-inputs"
        return 1
    elif [ -n "$amiid" ] && [ -n "$pubin" ]; then
        bad_Usage run_test "--ami-id and --awspub-inputs cannot be given together"
        return 1
    elif [ -n "$pubin" ]; then
        local out="" amiregion=""
        out=$(get_pubin_region_ami "$pubin") ||
            { stderr "failed to get amiid from $pubin"; return 1; }
        amiid=${out#* }
        amiregion=${out% *}
        [ "$amiregion" = "$AWS_REGION" ] || {
            stderr "ami '$amiid' from $pubin was in '$amiregion'." \
               "but AWS_REGION=$AWS_REGION"
            return 1;
        }
    fi

    if [ -z "$nodetype" ]; then
        local amiarch=
        amiarch=$(
            aws ec2 --region "$AWS_REGION" describe-images --image-ids "$amiid" \
                                                           --query 'Images[0].Architecture' \
                                                           --output text
        )
        case "$amiarch" in
            arm64)
               nodetype="$DEF_NODE_TYPE_ARM" ;;
            x86_64)
               nodetype="$DEF_NODE_TYPE_X86" ;;
            *)
               stderr "no instance type given and architecture '$amiarch' of '$amiid' is unknown"
               return 1
               ;;
        esac
    fi

    cluster=${cluster//VERSION/${version}}

    [ -d "$outd" ] || mkdir -p "$outd" ||
        fail "could not create $outd"

    local created=false out="" status=""

    cluster_create_if_needed "$cluster" "$version" ||
        { stderr "failed to create cluster"; return 1; }
    created=$_RET
    CLUSTER_NAME="$cluster"

    if [ "$created" = "true" ]; then
        debug "Created cluster $cluster"
    else
        debug "Re-using cluster $cluster"
    fi

    export KUBECONFIG="$TEMP_D/kube.config"
    cluster_kubeconfig "$cluster" > "$KUBECONFIG" ||
        { stderr "failed getting kubeconfig"; return 1; }

    nodegroup_create "$cluster" "$ngname" 2 "$nodetype" "$amiid" ||
        { stderr "failed to create nodegroup"; return 1; }
    if [ "$teardown" = "true" ]; then
        TEARDOWN_NODEGROUP="$ngname"
    fi

    local fails="" passes=""
    passes=()
    fails=()
    ## do some test here
    vr eksctl --region="$AWS_REGION" --cluster="$cluster" get nodegroups

    vr kubectl get pods -o wide
    vr kubectl get nodes -o wide
    vr kubectl get namespaces -o wide

    vr kubectl get pods -o wide || return 1

    vr kubectl run "$ngname-nginx0" --image=cgr.dev/chainguard/nginx:latest &&
        passes+=( nginx0 ) || fails+=( nginx0 )

    test_basepod "$ngname" "$ngname-basepod" &&
        passes+=( basepod ) || fails+=( basepod )

    local t=""
    for t in "${passes[@]}"; do
        log "PASS: $t"
    done
    for t in "${fails[@]}"; do
        log "FAIL: $t"
    done

    if [ "$teardown" = "true" ]; then
        nodegroup_destroy "$cluster" "$ngname" || {
            stderr "failed to destroy nodegroup $ngname in $cluster"
            return 1
        }
        TEARDOWN_NODEGROUP=""
        stderr "tore down nodegroup $ngname"
    else
        stderr "not tearing down $ngname"
    fi

    if [ ${#fails[@]} -ne 0 ]; then
        log "FAIL"
        return 1
    fi
    log "PASS"
}

tmpf() {
    if [ -z "$TEMP_D" ]; then
        TEMP_D=$(mktemp -d "${TMPDIR:-/tmp}/testeks.XXXXXX") ||
            { stderr "failed mktemp -d"; return 1; }
    fi
    local out=""
    out=$(mktemp "${TEMP_D}/XXXXXX") || {
        stderr "failed mktemp"
        return 1
    }
    _RET="$out"
}

setkubecfg() {
    local cluster="$1"
    cluster_kubeconfig "$cluster" > "$KUBECONFIG" ||
        { stderr "failed getting kubeconfig"; return 1; }
}

showfile() {
    {
    echo "# $1"
    cat "$1"
    } 1>&2
}

Usage_test_basepod() {
    cat <<EOF
Usage: ${0##*/} test-basepod nodegroup-name pod-name

   Deploy and test a multi-container pod on a specific node group.

   arguments:
      nodegroup-name           node group to schedule pod on (e.g. cluster-132-ng)
      pod-name                 name for the test pod (e.g. wolfi-test-pod)

   environment:
      KUBECONFIG               path to a kubeconfig file for the cluster

   Creates a pod with:

      - nginx container (cgr.dev/chainguard/nginx)
      - busybox container (cgr.dev/chainguard/busybox:latest)

   Fails if the pod does not become ready within 60 seconds.

EOF
}

test_basepod() {
    local ngname="$1" podname="$2"
    [ $# -eq 2 ] ||
        { stderr "expect 2 args (nodegroup and podname). got $#."; return 1; }
    [ -n "$KUBECONFIG" ] || { stderr "need to set KUBECONFIG"; return 1; }
    tmpf && pfile="$_RET" || return 1

    cat > "$pfile" <<EOF
apiVersion: v1
kind: Pod
metadata:
  name: "$podname"
spec:
  containers:
    - name: nginx0
      image: cgr.dev/chainguard/nginx
      ports:
        - containerPort: 80
    - name: busybox0
      image: cgr.dev/chainguard/busybox:latest
      command: ["/bin/sh"]
      args: ["-c", "while true; do sleep 3600; done"]
  nodeSelector:
    nodegroup: "$ngname"
EOF
    showfile "$pfile"
    vr kubectl apply -f "$pfile" ||
        { stderr "failed kubectl apply -f $ngname"; return 1; }

    vr kubectl wait --timeout=60s --for=condition=Ready "pod/$podname" ||
        { stderr "kubectl wait on pod/$podname failed"; return 1; }

    vr kubectl get pod "$podname"
}

SUBCMDS=(
    ami-list
    cluster-create-if-needed
    cluster-destroy
    cluster-kubeconfig
    cluster-list
    cluster-status
    nodegroup-create
    nodegroup-destroy
    get-pubin-region-ami
    dump-awspubin
    run-test
    test-basepod
)

if [ "$1" = "-h" ] || [ "$1" = "--help" ] || [ -z "$1" ]; then
    cat <<EOF
Usage: ${0##*/} subcommand [options]

Available subcommands:
EOF
    for _s in "${SUBCMDS[@]}"; do
        echo "  $_s"
    done
    echo ""
    echo "Use '${0##*/} subcommand --help' for subcommand-specific help."
    exit 0
fi

for _s in "${SUBCMDS[@]}"; do
    [ "$_s" = "$1" ] || continue
    VERBOSITY=1
    name="$1"
    fname=${name//-/_}
    shift
    if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
        "Usage_$fname" 2>/dev/null || stderr "No usage information for: $name"
        exit 0
    fi
    "$fname" "$@"
    exit
done

stderr "Bad subcmd '$1'. subcmds:"
for _s in "${SUBCMDS[@]}"; do
    stderr "  $_s"
done
exit 1
