     @EntitlementTest(expectedAccess = ALWAYS_DENIED)
-    static void runtimeAddShutdownHook() {
-        Runtime.getRuntime().addShutdownHook(NO_OP_SHUTDOWN_HOOK);
-    }
-
-    @EntitlementTest(expectedAccess = ALWAYS_DENIED)
