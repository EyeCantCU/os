#!/bin/sh

set -e
set -x
[ "$verbose" = "1" ] && set -x

# Cleanup our filesystem mounts and loop devices
cleanup() {
	loop_dev="$1"
	root_dir="$2"
	if [ -d "$root_dir" ]; then
		for i in dev/pts dev proc run sys; do
			umount $root_dir/$i || true
		done
		umount $root_dir/boot/efi $root_dir || true
	fi
	dmsetup remove $(echo $loop_dev | sed -e "s:.*/::")p1 || true
	dmsetup remove $(echo $loop_dev | sed -e "s:.*/::")p2 || true
	losetup -d $loop_dev || true
}

# Call cleanup() on any kind of exit
trap "__e=\$?; cleanup \$loop_dev \$root_dir || true; return \$__e" EXIT HUP INT QUIT TERM

# Pass in 3 positional arguments:
# (1) user:group, so that we can chown the file we're creating inside of this root container back to your user
# (2) linux kernel image file, to copy into place so that we can boot this disk image
# (3) initrd image file, to copy into place so that we can boot this disk image
[ -z "$1" ] && echo "ERROR: please supply user:group as the first argument" && exit 1
owner="$1"
[ -z "$2" ] && echo "ERROR: please supply a kernel image as the second argument" && exit 1
kernel="$2"
[ -z "$3" ] && echo "ERROR: please supply an initrd as the third argument" && exit 1
initrd="$3"

# This is the bootable disk image that we will create
disk="/srv/disk.raw"

# Add chainguard-keys, so that we can install "qemu" from enterprise packages
apk update
apk add chainguard-keys
echo "https://apk.cgr.dev/chainguard-private" >> /etc/apk/repositories
apk update
# Add qemu, and all other dependencies
apk add \
	blkid \
	device-mapper \
	dosfstools \
	e2fsprogs \
	gnutar \
	losetup \
	mount \
	multipath-tools \
	posix-libc-utils \
	qemu \
	systemd \
	umount \
	gnutar \
	jq \
	qemu \
	util-linux-misc

# Create a raw disk image, 10G seems to be the default disk image size for the major public clouds
qemu-img create -f raw $disk 10G
# Ensure that our original user owns this file (so that they can delete it without sudo)
chown $owner $disk

# Ensure that we use a GPT partition table
# 1000M for efi partition 1 is way too much, but we'll use this for now
# rest on partition 2
echo "g
n


+1000M
t
uefi
n



p
w
" | fdisk $disk

# losetup requires a privileged container
# Setup a loop device for our disk
loop_dev=$(losetup --show --find $disk)

# Print out our block device
blkid $loop_dev

# Run kpartx, to automatically create our /dev/mapper/* partitions
kpartx -a -v $loop_dev
ls -halF /dev/mapper/
uefi_partition="/dev/mapper/"$(echo $loop_dev | sed -e "s:.*/::")p1
root_partition="/dev/mapper/"$(echo $loop_dev | sed -e "s:.*/::")p2

# Format our uefi partition FAT32, and our root partition ext4
mkfs.fat -F 32 $uefi_partition
mkfs.ext4 -F $root_partition

# Mount our root partition, and our uefi boot partition
root_dir=$(mktemp -d /tmp/root.XXXXXX)
mount $root_partition $root_dir
df -h $root_dir
mkdir -p $root_dir/boot/efi
mount $uefi_partition $root_dir/boot/efi
df -h $root_dir/boot/efi

# Extract our initrd to our root partition, to be used as our root filesystem
cd $root_dir
gzip -cd "$initrd" | cpio -idmv
cd -

# Copy our kernel and initrd into our uefi boot partition
mkdir -p $root_dir/boot/grub
version=$(basename $kernel | sed -e "s:.*64-::")
cp -f "$kernel" $root_dir/boot/vmlinuz
cp -f "$initrd" $root_dir/boot/initrd
ls -halF $root_dir/boot/

# Setup our kernel command line parameters
# TODO: will need our filesystem uuid's here for switch_root
mkdir -p $root_dir/etc/kernel
uuid=$(blkid -o value $root_partition | head -n1)
echo "root=$uuid console=ttyS0 quiet net.ifnames=0 biosdevname=0" >$root_dir/etc/kernel/cmdline
for i in dev dev/pts proc run sys; do
	mkdir -p $root_dir/$i
	mount -o bind /$i $root_dir/$i
done

# Create our /dev/dm-* device here
# TODO: perhaps use dmsetup instead of mknod here?
major=$(ls -alF $uefi_partition | sed -e "s:,.*::" -e "s:.*\s::")
minor=$(ls -alF $uefi_partition | sed -e "s:.*,\s\+::" -e "s:\s.*::")
if [ ! -e /dev/dm-$minor ]; then
	mknod /dev/dm-$minor b $major $minor
	chmod 660 /dev/dm-$minor
	chown root:disk /dev/dm-$minor
fi
ls -halF /dev/dm-$minor

# Use systemd-boot and install our kernel and initrd
chroot $root_dir bootctl install --no-variables
chroot $root_dir kernel-install -v add $version /boot/vmlinuz /boot/initrd

# TODO: Probably need a different option to bootctl, but I haven't figured it out yet
# TODO: So I'm hacking the loader conf file directly to remove the leading "/boot/efi" from the kernel and initrd paths
sed -i -e "s:/boot/efi::" $root_dir/boot/efi/loader/entries/*conf

# Cleanup our mounts and devices
cleanup $loop_dev $root_dir

# Create a disk tarball for upload to Google Compute
# https://cloud.google.com/compute/docs/import/import-existing-image
sync
# tar --format=oldgnu -Sczf $disk.tar.gz $disk

image_name="$(basename "$(jq -rM '.annotations."org.opencontainers.image.source"' /srv/tmp-manifest.json)")"
version="$(jq -rM .contents.packages /srv/tmp-manifest.json | grep "${image_name}.*=.*" | tr -d '"' | cut -d'=' -f2 | sort -u | tr -d ',' | tr -d '.')"
timestamp="$(date "+%Y%m%d%H%M%S")"
if [ "$image_name" = "null" ] || [ "$image_name" = "" ]; then
	image_name="generic"
fi
if [ "$version" = "" ]; then
	version="latest"
fi

cd /srv

# Google format, raw+tar
tar --format=oldgnu -Sczf $disk.tar.gz $(basename $disk)
mv "$disk.tar.gz" "/srv/chainguard-${image_name}-${version}-${timestamp}.tar.gz"

# AWS and Azure Format  VHD(vpc)
# we need fixed and force_size because Azure will break down if we pass anything else
qemu-img convert -f raw -o subformat=fixed,force_size -O vpc "${disk}" "/srv/chainguard-${image_name}-${version}-${timestamp}-azure.vhd"
qemu-img convert -f raw -O vpc "${disk}" "/srv/chainguard-${image_name}-${version}-${timestamp}-aws.vhd"

cat > "/srv/chainguard-${image_name}-${version}-${timestamp}-aws.vhd.json" <<- EOF
{
"Description": "chainguard-${image_name}-${version}-${timestamp}",
"Format": "vhd",
"UserBucket": {
"S3Bucket": "wolfi-vm-images-workloads",
"S3Key": "chainguard-${image_name}-${version}-${timestamp}-aws.vhd"
}
}
EOF


chown "$owner" $disk /srv/*.tar.gz /srv/*.vhd*
sync
