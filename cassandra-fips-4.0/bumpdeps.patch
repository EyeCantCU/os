 build.xml | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/build.xml b/build.xml
index 34e95ba431..43d7d2c297 100644
--- a/build.xml
+++ b/build.xml
@@ -560,7 +560,7 @@
           <dependency groupId="commons-cli" artifactId="commons-cli" version="1.1"/>
