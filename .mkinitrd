#!/bin/sh

# This must run within a docker container in order to run mknod and create nodes inside of the cpio tarball
set -x
set -e
[ "$verbose" = "1" ] && set -x

[ -z "$1" ] && echo "ERROR: please supply your UID:GID as the first argument" 1>&2 && exit 1
[ -z "$2" ] && echo "ERROR: please supply your ARCH as the second argument" 1>&2 && exit 1

owner="$1"
arch="$2"
mission="$3"
dir="/tmp"

# Make an initrd
apk update
apk add apko

# Start with wolfi-base, add systemd for init and mount for some boot processes
cat <<EOF >"$dir"/base.yaml
contents:
  keyring:
    - https://packages.wolfi.dev/os/wolfi-signing.rsa.pub
    - /etc/apk/keys/local-melange.rsa.pub
  repositories:
    - https://packages.wolfi.dev/os
    - /work/packages
  packages:
    - wolfi-base
    - e2fsprogs
    - iproute2
    - mount
    - umount
    - kmod
    - kmod-libs
    - kbd
    - systemd
    - systemd-init
    - systemd-default-network	# default DHCP for all interfaces, we can drop this if we configure manually
    - systemd-logind-stub	# drop into a shell, we can remove this if we only want remote access
    - util-linux-misc
    - dockerd-service
    - containerd-service
    - openssh-server
    - openssh-service
    - grype
archs:
  - $arch
EOF

# Generate a base wolfi tarball
apko build-minirootfs $dir/base.yaml $dir/base.tar.gz
mkdir -p $dir/initrd/rootfs

# Extract that tarball so that we can add some configuration
tar -C $dir/initrd/rootfs -xf $dir/base.tar.gz || true

rm -f "$dir"/initrd/rootfs/init
# Create an init script in our initrd
cat <<EOF >"$dir"/initrd/rootfs/init
#!/bin/sh

mkdir -p /proc /sys /dev
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev

mkdir -p /root_dir
uuid=\$(sed -e "s:.*root=::" -e "s: .*::" /proc/cmdline)
init=\$(sed -e "s:.*init=::" -e "s: .*::" /proc/cmdline)
if [ -x "\$init" ]; then
	# Exec init as overriden on the kernel command line
	exec \$init
elif mount --uuid \$uuid /root_dir 2>/dev/null; then
	# Mount specified persistent disk and boot systemd
	exec switch_root /root_dir /usr/lib/systemd/systemd --system --log-target=console --unit=multi-user.target
else
	# Boot systemd in initrd
	exec /usr/lib/systemd/systemd --system --log-target=console --unit=multi-user.target
fi
EOF
chmod 755 "$dir"/initrd/rootfs/init

# Set the hostname to "wolfi" for a little lightweight branding
echo "wolfi" > $dir/initrd/rootfs/etc/hostname
sed -i -e "s/\slocalhost\s/ localhost wolfi /" $dir/initrd/rootfs/etc/hosts

mkdir -p /$dir/initrd/rootfs/root/.ssh/
echo "${SSHKEY}" | base64 -d > /$dir/initrd/rootfs/root/.ssh/authorized_keys
chmod 0400 /$dir/initrd/rootfs/root/.ssh/authorized_keys

# Archive and compress this directory structure into a cpio file for initrd
( cd $dir/initrd/rootfs && find . >../files )
( cd $dir/initrd/rootfs && cpio --format=newc -o ) <$dir/initrd/files | gzip --to-stdout >/srv/initrd.$arch.cpio.gz

# Chown this file back to the user who ran the docker command that built this file
# Otherwise, the user is going to end up with a root-owned file in their directory
chown "$owner" /srv/initrd.$arch.cpio.gz
