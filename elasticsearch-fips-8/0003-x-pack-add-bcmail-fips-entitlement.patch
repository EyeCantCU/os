Date: Sat, 9 Aug 2025 04:45:34 +0100
Subject: [PATCH 3/7] x-pack: add bcmail-fips entitlement

watcher plugin requires access to bcmail-fips jar, thus grant it.
---
 .../watcher/src/main/plugin-metadata/entitlement-policy.yaml    | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/x-pack/plugin/watcher/src/main/plugin-metadata/entitlement-policy.yaml b/x-pack/plugin/watcher/src/main/plugin-metadata/entitlement-policy.yaml
index 0b26b58eda6..118ce35af46 100644
--- a/x-pack/plugin/watcher/src/main/plugin-metadata/entitlement-policy.yaml
+++ b/x-pack/plugin/watcher/src/main/plugin-metadata/entitlement-policy.yaml
@@ -13,4 +13,6 @@ ALL-UNNAMED:
     - relative_path: ".mailcap"
       relative_to: "home"
       mode: "read"
+    - path: "/usr/share/elasticsearch/lib/bcmail-fips.jar"
+      mode: "read"
 
