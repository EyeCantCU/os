From cd190e1bf02cb8812809b4cb558d46b3fb51e162 Mon Sep 17 00:00:00 2001
From: Dimitri John Ledkov <dimitri.ledkov@surgut.co.uk>
Date: Wed, 20 Aug 2025 16:22:01 +0100
Subject: [PATCH] Add envoy patches

Patch istio, to add envoy patches.
---
 0001-Add-quiche.patch | 83 +++++++++++++++++++++++++++++++++++++++++++
 WORKSPACE             |  2 ++
 2 files changed, 85 insertions(+)
 create mode 100644 0001-Add-quiche.patch

diff --git a/WORKSPACE b/WORKSPACE
index 9919e14f..9af77857 100644
--- a/WORKSPACE
+++ b/WORKSPACE
@@ -36,6 +36,8 @@ ENVOY_REPO = "envoy"
 http_archive(
     name = "envoy",
     sha256 = ENVOY_SHA256,
+    patches = ["//:0001-version-Print-FIPS-module-version.patch", "//:0001-Add-quiche.patch"],
+    patch_args = ["-p1"],
     strip_prefix = ENVOY_REPO + "-" + ENVOY_SHA,
     url = "https://github.com/" + ENVOY_ORG + "/" + ENVOY_REPO + "/archive/" + ENVOY_SHA + ".tar.gz",
 )
