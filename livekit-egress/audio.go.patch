Description: Switch AAC encoder from faac to avenc_aac; adjust AAC caps to F32LE
.
Many distros do not ship faac due to licensing issues; avenc_aac is available in our gst-libav package.
avenc_aac sink expects audio/x-raw,F32LE; update caps accordingly.
Author: Matthew Ramirez <matthew.ramirez@chainguard.dev>
Forwarded: not-needed

diff --git a/pkg/pipeline/builder/audio.go b/pkg/pipeline/builder/audio.go
index 6d1b814..ac7de12 100644
--- a/pkg/pipeline/builder/audio.go
+++ b/pkg/pipeline/builder/audio.go
@@ -314,14 +314,15 @@ func (b *AudioBin) addEncoder() error {
 		return b.bin.AddElement(opusEnc)
 
 	case types.MimeTypeAAC:
-		faac, err := gst.NewElement("faac")
-		if err != nil {
-			return errors.ErrGstPipelineError(err)
-		}
-		if err = faac.SetProperty("bitrate", int(b.conf.AudioBitrate*1000)); err != nil {
-			return errors.ErrGstPipelineError(err)
-		}
-		return b.bin.AddElement(faac)
+		// Use gst-libav AAC encoder
+    aacEnc, err := gst.NewElement("avenc_aac")
+    if err != nil {
+        return errors.ErrGstPipelineError(err)
+    }
+    if err = aacEnc.SetProperty("bitrate", int(b.conf.AudioBitrate*1000)); err != nil {
+        return errors.ErrGstPipelineError(err)
+    }
+    return b.bin.AddElement(aacEnc)
 
 	case types.MimeTypeRawAudio:
 		return nil
@@ -371,10 +372,11 @@ func newAudioCapsFilter(p *config.PipelineConfig, channel int) (*gst.Element, er
 			channelCaps,
 		))
 	case types.MimeTypeAAC:
-		caps = gst.NewCapsFromString(fmt.Sprintf(
-			"audio/x-raw,format=S16LE,layout=interleaved,rate=%d,%s",
-			p.AudioFrequency, channelCaps,
-		))
+		// avenc_aac’s sink template expects F32LE; keep configured rate.
+    caps = gst.NewCapsFromString(fmt.Sprintf(
+        "audio/x-raw,format=F32LE,layout=interleaved,rate=%d,%s",
+        p.AudioFrequency, channelCaps,
+    ))
 	default:
 		return nil, errors.ErrNotSupported(string(p.AudioOutCodec))
 	}
