--- a/cmake/Modules/FindCUB.cmake
+++ b/cmake/Modules/FindCUB.cmake
@@ -2,12 +2,25 @@
 #  CUB_FOUND        - system has CUB
 #  CUB_INCLUDE_DIRS - the CUB include directory
 
+# First try the new CUDA 13.0+ location under cccl/
 find_path(CUB_INCLUDE_DIR
         HINTS "${CUDA_TOOLKIT_INCLUDE}"
-        NAMES cub/cub.cuh
+        NAMES cccl/cub/cub.cuh
         DOC "The directory where CUB includes reside"
 )
 
+# Fall back to the old location for older CUDA versions
+if(NOT CUB_INCLUDE_DIR)
+  find_path(CUB_INCLUDE_DIR
+          HINTS "${CUDA_TOOLKIT_INCLUDE}"
+          NAMES cub/cub.cuh
+          DOC "The directory where CUB includes reside"
+  )
+else()
+  # For CUDA 13.0+, append cccl to the include dir
+  set(CUB_INCLUDE_DIR "${CUB_INCLUDE_DIR}/cccl")
+endif()
+
 set(CUB_INCLUDE_DIRS ${CUB_INCLUDE_DIR})
 
 include(FindPackageHandleStandardArgs)
