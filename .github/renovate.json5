{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  "extends": [
    "mergeConfidence:all-badges"
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^os/.*\\.yaml$/',
        '/^enterprise-packages/.*\\.yaml$/',
        '/^extra-packages/.*\\.yaml$/',
      ],
      matchStrings: [
        '  # renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[a-z.:-]+)( versioning=(?<versioning>[a-z]+))?\\n  version: "(?<currentValue>[\\d+.]*)"'
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}",
    }
  ]
}
