#!/usr/bin/env bash

if ! command -v yq &> /dev/null; then
    echo "Error: This script requires yq to be installed."
    exit 1
fi

usage() {
    cat << EOF
Usage: ${0} [options] <config1> [<config2> ...]

Compare packages included across multiple configuration files.

Options:
    -d, --delta-only    Show only packages that differ across configurations

Arguments:
    <config1> [<config2> ...]    One or more config YAML files to compare

Examples:
    ${0} aws-base.yaml gcp-base.yaml     # Compare AWS and GCP base configurations
    ${0} -d gcp-*.yaml                   # Compare all GCP configurations, showing only differing packages
    ${0} --delta-only *-base.yaml        # Compare base configs across all providers, showing only differing packages
EOF
}

delta_only=false
files=()

while [[ $# -gt 0 ]]; do
    case "${1}" in
        -d|--delta-only)
            delta_only=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "Error: Unknown option: ${1}"
            usage
            exit 1
            ;;
        *)
            files+=("${1}")
            shift
            ;;
    esac
done

if [[ ${#files[@]} -lt 1 ]]; then
    usage
    exit 1
fi

if [[ -t 1 && -n ${TERM} && ${TERM} != dumb && -z ${NO_COLOR} ]]; then
    readonly fmt_bold='\033[1m'
    readonly fmt_reset='\033[0m'
else
    readonly fmt_bold=
    readonly fmt_reset=
fi

declare -A package_exists
declare -a all_packages

for (( i=0; i < ${#files[@]}; i++)); do
    mapfile -t packages < <(yq '.contents.packages[]' "${files[$i]}")
    for pkg in "${packages[@]}"; do
        package_exists["${pkg},${i}"]=true
        all_packages+=("${pkg}")
    done
done

mapfile -t all_packages < <(printf '%s\n' "${all_packages[@]}" | sort -u)

longest_package=0
for pkg in "${all_packages[@]}"; do
    pkg_length=${#pkg}
    if (( pkg_length > longest_package )); then
        longest_package=${pkg_length}
    fi
done

readonly column_width=$(( longest_package + 4 ))

header="  "  # Add the same indent used for rows
for config in "${files[@]}"; do
    config=$(basename "${config}" .yaml)
    header="${header}$(printf "%-${column_width}s" "${config}")"
done
echo "${header}"
echo "  $(printf '%0.s-' $(seq 1 $(( ${#files[@]} * column_width ))))"

for package in "${all_packages[@]}"; do
    present_count=0
    for (( i=0; i < ${#files[@]}; i++ )); do
        if [[ -n ${package_exists["${package},${i}"]} ]]; then
            present_count=$(( present_count + 1 ))
        fi
    done

    if [[ ${present_count} -eq ${#files[@]} ]]; then
        in_all_configs=true
    else
        in_all_configs=false
    fi

    if [[ ${in_all_configs} == true && ${delta_only} == true ]]; then
        continue
    fi

    line=""
    for (( i=0; i < ${#files[@]}; i++ )); do
        if [[ ${package_exists["${package},${i}"]} == true ]]; then
            line="${line}$(printf "%-${column_width}s" "${package}")"
        else
            line="${line}$(printf "%-${column_width}s" "")"
        fi
    done

    if [[ ${in_all_configs} == false ]]; then
        echo -e "${fmt_bold}* ${line}${fmt_reset}"
    else
        echo "  ${line}"
    fi
done
