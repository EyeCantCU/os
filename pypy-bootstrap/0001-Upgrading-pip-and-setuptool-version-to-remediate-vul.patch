From: uti <uti.edun@chainguard.dev>
Date: Mon, 24 Feb 2025 22:28:01 +0000
Subject: [PATCH] Upgrading pip and setuptool version to remediate vulns

---
 lib-python/2.7/ensurepip/__init__.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/lib-python/2.7/ensurepip/__init__.py b/lib-python/2.7/ensurepip/__init__.py
index 6685621c57..de69c2adba 100644
--- a/lib-python/2.7/ensurepip/__init__.py
+++ b/lib-python/2.7/ensurepip/__init__.py
@@ -14,9 +14,9 @@ import warnings
 __all__ = ["version", "bootstrap"]
 
 
-_SETUPTOOLS_VERSION = "44.0.0"
+_SETUPTOOLS_VERSION = "70.0.0"
 
-_PIP_VERSION = "20.0.2"
+_PIP_VERSION = "23.3"
 
 _PROJECTS = [
     ("setuptools", _SETUPTOOLS_VERSION),
-- 
