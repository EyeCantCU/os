From 0f250a8834ac20bcad906d8c3c70d787244d2de5 Mon Sep 17 00:00:00 2001
From: Dentrax <furkan.turkal@chainguard.dev>
Date: Thu, 9 Oct 2025 12:16:23 +0300
Subject: [PATCH] modules: add slf4j-nop where it is missing

Default startup of elasticsearch results in warnings:

> [WARN ][stderr ] [es] SLF4J: No SLF4J providers were found.
> [WARN ][stderr ] [es] SLF4J: Defaulting to no-operation (NOP) logger implementation
> [WARN ][stderr ] [es] SLF4J: See https://www.slf4j.org/codes.html#noProviders for further details.

It seems like most modules and plugins install nop logger, but some
don't. If one installs them everywhere, these warnings seem to go
away.

Signed-off-by: Dentrax <furkan.turkal@chainguard.dev>
Co-authored-by: Dimitri John Ledkov <dimitri.ledkov@surgut.co.uk>
---
 modules/repository-gcs/build.gradle   | 2 ++
 modules/repository-s3/build.gradle    | 2 ++
 x-pack/plugin/ent-search/build.gradle | 2 ++
 3 files changed, 6 insertions(+)

diff --git a/modules/repository-gcs/build.gradle b/modules/repository-gcs/build.gradle
index 2a2efb9c..2265b32f 100644
--- a/modules/repository-gcs/build.gradle
+++ b/modules/repository-gcs/build.gradle
@@ -59,6 +59,8 @@ dependencies {
 
   testImplementation project(':test:fixtures:gcs-fixture')
   yamlRestTestImplementation project(':test:fixtures:gcs-fixture')
+
+  runtimeOnly "org.slf4j:slf4j-nop:${versions.slf4j}"
 }
 
 restResources {
diff --git a/modules/repository-s3/build.gradle b/modules/repository-s3/build.gradle
index c45eaf39..c0760938 100644
--- a/modules/repository-s3/build.gradle
+++ b/modules/repository-s3/build.gradle
@@ -53,6 +53,8 @@ dependencies {
   javaRestTestImplementation project(':test:fixtures:s3-fixture')
   javaRestTestImplementation project(':modules:repository-s3')
 
+  runtimeOnly "org.slf4j:slf4j-nop:${versions.slf4j}"
+
   yamlRestTestRuntimeOnly "org.slf4j:slf4j-simple:${versions.slf4j}"
   internalClusterTestRuntimeOnly "org.slf4j:slf4j-simple:${versions.slf4j}"
 }
diff --git a/x-pack/plugin/ent-search/build.gradle b/x-pack/plugin/ent-search/build.gradle
index 52634ad7..ed578320 100644
--- a/x-pack/plugin/ent-search/build.gradle
+++ b/x-pack/plugin/ent-search/build.gradle
@@ -35,6 +35,8 @@ dependencies {
   javaRestTestImplementation(project(path: xpackModule('core')))
   javaRestTestImplementation(testArtifact(project(xpackModule('core'))))
   javaRestTestImplementation(project(':modules:lang-mustache'))
+
+  runtimeOnly "org.slf4j:slf4j-nop:${versions.slf4j}"
 }
 
 testClusters.configureEach {
-- 
