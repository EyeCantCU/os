diff --git a/cmake/third_party.cmake b/cmake/third_party.cmake
index c4d851f..b8bc5a3 100644
--- a/cmake/third_party.cmake
+++ b/cmake/third_party.cmake
@@ -320,15 +320,33 @@ add_third_party(
   CMAKE_PASS_FLAGS "-DCMAKE_POSITION_INDEPENDENT_CODE=ON -DBUILD_SHARED_LIBS=OFF"
 )

+# Locate system liburing
+find_path(LIBURING_INCLUDE_DIR liburing.h)
+find_library(LIBURING_LIBRARY uring)
+
+if (LIBURING_INCLUDE_DIR AND LIBURING_LIBRARY)
+  # If found, use the installed version
+  message(STATUS "Using system-installed liburing at ${LIBURING_LIBRARY}")
+  
+  # Define an imported target for liburing to link against
+  add_library(TRDP::uring SHARED IMPORTED)
+  set_target_properties(TRDP::uring PROPERTIES
+    IMPORTED_LOCATION ${LIBURING_LIBRARY}
+    INTERFACE_INCLUDE_DIRECTORIES ${LIBURING_INCLUDE_DIR}
+  )
+else()
+  # If not found, proceed with fetching and building liburing as third-party dependency
+  message(STATUS "liburing not found in system, fetching and building as third-party dependency")

