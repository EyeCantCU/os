From df918dd23b7f209beb2d5be57539663052cc15aa Mon Sep 17 00:00:00 2001
From: Kai Zhang <kaiming.zhang@chainguard.dev>
Date: Wed, 8 Jan 2026 00:00:00 +0000
Subject: [PATCH] Fix C++ compilation issues

1. The defaulted operator<=> doesn't work because absl::flat_hash_map
   doesn't support three-way comparison. Replace with explicit operator==.
2. Fix redefinition of To<unsigned long> when uint64_t and unsigned long
   are the same type (Linux x86_64).
---

--- a/vmsdk/src/cluster_map.h
+++ b/vmsdk/src/cluster_map.h
@@ -60,7 +60,14 @@ struct NodeInfo {
   absl::flat_hash_map<std::string, std::string> additional_network_metadata;
   const ShardInfo* shard;

-  auto operator<=>(const NodeInfo&) const = default;
+  bool operator==(const NodeInfo& other) const {
+    return node_id == other.node_id &&
+           is_primary == other.is_primary &&
+           is_local == other.is_local &&
+           socket_address == other.socket_address &&
+           additional_network_metadata == other.additional_network_metadata &&
+           shard == other.shard;
+  }

   friend std::ostream& operator<<(std::ostream& os, const NodeInfo& node_info);
 };
--- a/vmsdk/src/type_conversions.h
+++ b/vmsdk/src/type_conversions.h
@@ -116,7 +116,8 @@ inline absl::StatusOr<uint64_t> To(absl::string_view str) {
   return ToNumeric<uint64_t>(str);
 }

-#if defined(__clang__) && !defined(RunningClangd)
+// Skip on LP64 systems where unsigned long == uint64_t (would cause redefinition)
+#if defined(__clang__) && !defined(RunningClangd) && !defined(__LP64__)
 template <>
 inline absl::StatusOr<unsigned long> To(absl::string_view str) {
   return ToNumeric<uint64_t>(str);
