From 05abbb3dc82d937a5c68d7ffcbea578e0dff58ed Mon Sep 17 00:00:00 2001
From: Debasish Biswas <debasishbsws.dev@gmail.com>
Date: Wed, 15 Jan 2025 00:14:35 +0530
Subject: [PATCH] Fix BUILD v4.0.0: Update Boost API usage: Replace reset() with restart()

In the latest version of boost 1.87 the API change the upstream uses the older API to address that replace the deprecated ioContext.reset() with ioContext.restart().

Signed-off-by: Debasish Biswas <debasishbsws.dev@gmail.com>
---
 common/ChildProcess/ChildProcess.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/common/ChildProcess/ChildProcess.cpp b/common/ChildProcess/ChildProcess.cpp
index c896a63..cc27e3d 100644
--- a/common/ChildProcess/ChildProcess.cpp
+++ b/common/ChildProcess/ChildProcess.cpp
@@ -236,7 +236,7 @@ struct ChildProcess::Impl
                 while (!cancellationToken.stop_requested())
                 {
                     ioContext.run_for(boost::asio::chrono::milliseconds(500));
-                    ioContext.reset();
+                    ioContext.restart();
                 }
             }
             catch (std::exception const &e)
