From 6524a3b48b62a3d47fef9411cd2228b0eac45a02 Mon Sep 17 00:00:00 2001
From: Dimitri John Ledkov <dimitri.ledkov@surgut.co.uk>
Date: Tue, 1 Oct 2024 16:39:27 +0100
Subject: [PATCH] crypto: Always use openssl for obsolete cryptography

Always use openssl (via boring indirection), when requesting to use
obsolete cryptography. Right now the "boring.Supports*" checks are
incorrect, as they allow fallback to gocrypto, when in practice, other
implementations lie that they support this and then block them at
runtime.

Signed-off-by: Dimitri John Ledkov <dimitri.ledkov@surgut.co.uk>
---
 src/crypto/des/cipher.go | 4 ++--
 src/crypto/md5/md5.go    | 4 ++--
 src/crypto/rc4/rc4.go    | 6 +++---
 3 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/src/crypto/des/cipher.go b/src/crypto/des/cipher.go
index 0c11654b03..3e0ea8b055 100644
--- a/src/crypto/des/cipher.go
+++ b/src/crypto/des/cipher.go
@@ -31,7 +31,7 @@ func NewCipher(key []byte) (cipher.Block, error) {
 	if len(key) != 8 {
 		return nil, KeySizeError(len(key))
 	}
-	if boring.Enabled && boring.SupportsDESCipher() {
+	if boring.Enabled {
 		return boring.NewDESCipher(key)
 	}
 
@@ -78,7 +78,7 @@ func NewTripleDESCipher(key []byte) (cipher.Block, error) {
 	if len(key) != 24 {
 		return nil, KeySizeError(len(key))
 	}
-	if boring.Enabled && boring.SupportsTripleDESCipher() {
+	if boring.Enabled {
 		return boring.NewTripleDESCipher(key)
 	}
 
diff --git a/src/crypto/md5/md5.go b/src/crypto/md5/md5.go
index 1e6a419587..0ab7038c83 100644
--- a/src/crypto/md5/md5.go
+++ b/src/crypto/md5/md5.go
@@ -100,7 +100,7 @@ func consumeUint32(b []byte) ([]byte, uint32) {
 // implements [encoding.BinaryMarshaler] and [encoding.BinaryUnmarshaler] to
 // marshal and unmarshal the internal state of the hash.
 func New() hash.Hash {
-	if boring.Enabled && boring.SupportsHash(crypto.MD5) {
+	if boring.Enabled {
 		return boring.NewMD5()
 	}
 	d := new(digest)
@@ -180,7 +180,7 @@ func (d *digest) checkSum() [Size]byte {
 
 // Sum returns the MD5 checksum of the data.
 func Sum(data []byte) [Size]byte {
-	if boring.Enabled && boring.SupportsHash(crypto.MD5) {
+	if boring.Enabled {
 		return boring.MD5(data)
 	}
 	var d digest
diff --git a/src/crypto/rc4/rc4.go b/src/crypto/rc4/rc4.go
index 47726d0ebe..069a62c42d 100644
--- a/src/crypto/rc4/rc4.go
+++ b/src/crypto/rc4/rc4.go
@@ -36,7 +36,7 @@ func NewCipher(key []byte) (*Cipher, error) {
 	if k < 1 || k > 256 {
 		return nil, KeySizeError(k)
 	}
-	if boring.Enabled && boring.SupportsRC4() {
+	if boring.Enabled {
 		c, err := boring.NewRC4Cipher(key)
 		if err != nil {
 			return nil, err
@@ -60,7 +60,7 @@ func NewCipher(key []byte) (*Cipher, error) {
 // Deprecated: Reset can't guarantee that the key will be entirely removed from
 // the process's memory.
 func (c *Cipher) Reset() {
-	if boring.Enabled && boring.SupportsRC4() {
+	if boring.Enabled {
 		c.boring.Reset()
 		return
 	}
@@ -73,7 +73,7 @@ func (c *Cipher) Reset() {
 // XORKeyStream sets dst to the result of XORing src with the key stream.
 // Dst and src must overlap entirely or not at all.
 func (c *Cipher) XORKeyStream(dst, src []byte) {
-	if boring.Enabled && boring.SupportsRC4() {
+	if boring.Enabled {
 		c.boring.XORKeyStream(dst, src)
 		return
 	}
-- 
2.43.0

