Description: Fix ConditionalInheritance Method Resolution Order (MRO) errors in authentik version 2025.10.0
.
Comment out ConditionalInheritance calls from RadiusProviderSerializer and
SCIMProviderSerializer to prevent Method Resolution Order (MRO) errors
when the authentik.enterprise module is not present.

Author: Matthew Ramirez <matthew.ramirez@chainguard.dev>
Forwarded: not-needed

diff --git a/authentik/core/api/users.py b/authentik/core/api/users.py
index 1a5b9a9..2f12be9 100644
--- a/authentik/core/api/users.py
+++ b/authentik-fips/core/api/users.py
@@ -486,7 +486,6 @@ class UsersFilter(FilterSet):
 
 
 class UserViewSet(
-    ConditionalInheritance("authentik.enterprise.reports.api.reports.ExportMixin"),
     UsedByMixin,
     ModelViewSet,
 ):
diff --git a/authentik/endpoints/connectors/agent/api/connectors.py b/authentik/endpoints/connectors/agent/api/connectors.py
index b77a60b..3375d4a 100644
--- a/authentik/endpoints/connectors/agent/api/connectors.py
+++ b/authentik-fips/endpoints/connectors/agent/api/connectors.py
@@ -81,9 +81,6 @@ class MDMConfigSerializer(PassiveSerializer):
 
 
 class AgentConnectorViewSet(
-    ConditionalInheritance(
-        "authentik.enterprise.endpoints.connectors.agent.api.connectors.AgentConnectorViewSetMixin"
-    ),
     UsedByMixin,
     ModelViewSet,
 ):
diff --git a/authentik/events/api/events.py b/authentik/events/api/events.py
index 104d3a1..323468f 100644
--- a/authentik/events/api/events.py
+++ b/authentik-fips/events/api/events.py
@@ -119,7 +119,7 @@ class EventsFilter(django_filters.FilterSet):
 
 
 class EventViewSet(
-    ConditionalInheritance("authentik.enterprise.reports.api.reports.ExportMixin"), ModelViewSet
+    ModelViewSet
 ):
     """Event Read-Only Viewset"""
 
