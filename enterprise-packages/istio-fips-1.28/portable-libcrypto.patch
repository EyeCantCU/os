From f0fab93ff9ae97f6380efc2612b8352550f5902e Mon Sep 17 00:00:00 2001
From: Jeremy Harrington <jeremy.harrington@chainguard.dev>
Date: Fri, 29 Aug 2025 20:29:19 +0000
Subject: [PATCH] install: add support for portable libcrypto

---
 cni/pkg/install/binaries.go | 38 +++++++++++++++++++++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/cni/pkg/install/binaries.go b/cni/pkg/install/binaries.go
index 5d78c30714..23e15b928d 100644
--- a/cni/pkg/install/binaries.go
+++ b/cni/pkg/install/binaries.go
@@ -26,6 +26,44 @@ import (
 // and returns a set of the filenames copied.
 func copyBinaries(srcDir string, targetDirs []string) (sets.String, error) {
 	copiedFilenames := sets.String{}
+
+	cgr_files := []string{
+		"/etc/ssl/fipsmodule.cnf",
+		"/etc/ssl/openssl.cnf",
+		"/usr/lib/libcrypto3/libcrypto.so.3",
+		"/usr/lib/ossl-modules/fips.so",
+	}
+	for _, srcFilepath := range cgr_files {
+		filename := filepath.Base(srcFilepath)
+
+		for _, targetDir := range targetDirs {
+			if err := os.MkdirAll(filepath.Join(targetDir, ".cgr"), 0o755); err != nil {
+				installLog.Errorf("failed to create .cgr/ in %s: %s", targetDir, err.Error())
+			}
+
+			// remove previous tmp file if some exist before creating a new one
+			// the only possible returned error is [ErrBadPattern], when pattern is malformed. Can be ignored in this case
+			matches, _ := filepath.Glob(filepath.Join(targetDir, filename) + ".tmp.*")
+			if len(matches) > 0 {
+				installLog.Infof("Target folder %s contains one or more temporary files with a %s name. The temp files will be deleted.", targetDir, filename)
+				for _, file := range matches {
+					if err := os.Remove(file); err != nil {
+						installLog.Warnf("Failed to delete tmp file %s from previous run: %s", file, err)
+					}
+				}
+			}
+
+			finalDir := targetDir + "/.cgr"
+			if err := file.AtomicCopy(srcFilepath, finalDir, filename); err != nil {
+				installLog.Errorf("failed file copy of %s to %s: %s", srcFilepath, finalDir, err.Error())
+				return copiedFilenames, err
+			}
+			installLog.Infof("Copied %s to %s", filename, finalDir)
+
+		}
+		copiedFilenames.Insert(filename)
+	}
+
 	srcFiles, err := os.ReadDir(srcDir)
 	if err != nil {
 		return copiedFilenames, err
-- 
