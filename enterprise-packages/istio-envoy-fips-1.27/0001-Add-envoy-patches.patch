From ee709f44ef95f14e508b55664c30aeb9b44dd7e8 Mon Sep 17 00:00:00 2001
From: Dimitri John Ledkov <dimitri.ledkov@surgut.co.uk>
Date: Wed, 20 Aug 2025 16:22:01 +0100
Subject: [PATCH] Add envoy patches

Patch istio, to add envoy patches.
---
 WORKSPACE | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/WORKSPACE b/WORKSPACE
index 40acf942..e4933ff3 100644
--- a/WORKSPACE
+++ b/WORKSPACE
@@ -35,6 +35,11 @@ ENVOY_REPO = "envoy"
 # persist the option in `user.bazelrc`.
 http_archive(
     name = "envoy",
+    patch_args = ["-p1"],
+    patches = [
+        "//:0001-version-Print-FIPS-module-version.patch",
+        "//:0001-fips-always-set-ssl_compliance_policy_fips_202205.patch",
+    ],
     sha256 = ENVOY_SHA256,
     strip_prefix = ENVOY_REPO + "-" + ENVOY_SHA,
     url = "https://github.com/" + ENVOY_ORG + "/" + ENVOY_REPO + "/archive/" + ENVOY_SHA + ".tar.gz",
-- 
2.51.0

