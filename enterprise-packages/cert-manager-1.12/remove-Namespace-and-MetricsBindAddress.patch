From d3d0b855549781b75a4e739740a8e5d4ba2c6115 Mon Sep 17 00:00:00 2001
From: Kyle Steere <kyle.steere@chainguard.dev>
Date: Thu, 17 Apr 2025 17:15:26 -0500
Subject: [PATCH] removed Namespace and MetricsBindAddress due to update to
 sigs.k8s.io/controller-runtime

Signed-off-by: Kyle Steere <kyle.steere@chainguard.dev>
---
 cmd/cainjector/app/start.go | 2 --
 1 file changed, 2 deletions(-)

diff --git a/cmd/cainjector/app/start.go b/cmd/cainjector/app/start.go
index d49549cc8..21b6b0d59 100644
--- a/cmd/cainjector/app/start.go
+++ b/cmd/cainjector/app/start.go
@@ -204,7 +204,6 @@ func (o InjectorControllerOptions) RunInjectorController(ctx context.Context) er
 		util.RestConfigWithUserAgent(ctrl.GetConfigOrDie(), "cainjector"),
 		ctrl.Options{
 			Scheme:                        api.Scheme,
-			Namespace:                     o.Namespace,
 			LeaderElection:                o.LeaderElect,
 			LeaderElectionNamespace:       o.LeaderElectionNamespace,
 			LeaderElectionID:              "cert-manager-cainjector-leader-election",
@@ -213,7 +212,6 @@ func (o InjectorControllerOptions) RunInjectorController(ctx context.Context) er
 			LeaseDuration:                 &o.LeaseDuration,
 			RenewDeadline:                 &o.RenewDeadline,
 			RetryPeriod:                   &o.RetryPeriod,
-			MetricsBindAddress:            "0",
 		})
 	if err != nil {
 		return fmt.Errorf("error creating manager: %v", err)
--
