From 2cea4d01c01df0724115e047953d3c1960d1a39b Mon Sep 17 00:00:00 2001
From: Dimitri John Ledkov <dimitri.ledkov@surgut.co.uk>
Date: Wed, 4 Mar 2026 14:57:47 +0000
Subject: [PATCH] jlink and jmod executes with bcfips already

---
 configure            | 0
 make/CreateJmods.gmk | 2 +-
 make/Images.gmk      | 2 +-
 3 files changed, 2 insertions(+), 2 deletions(-)
 mode change 100644 => 100755 configure

diff --git a/configure b/configure
old mode 100644
new mode 100755
diff --git a/make/CreateJmods.gmk b/make/CreateJmods.gmk
index 40bceda69a9..43dc4eec716 100644
--- a/make/CreateJmods.gmk
+++ b/make/CreateJmods.gmk
@@ -259,7 +259,7 @@ $(eval $(call SetupExecute, create_$(JMOD_FILE), \
     OUTPUT_FILE := $(JMODS_DIR)/$(JMOD_FILE), \
     SUPPORT_DIR := $(JMODS_SUPPORT_DIR), \
     PRE_COMMAND := $(RM) $(JMODS_DIR)/$(JMOD_FILE) $(JMODS_SUPPORT_DIR)/$(JMOD_FILE), \
-    COMMAND := $(JMOD) $(JMOD_SMALL_FLAGS) create --module-version $(VERSION_SHORT) \
+    COMMAND := JAVA_TOOL_OPTIONS=--module-path=/usr/share/java/bouncycastle-fips $(JMOD) $(JMOD_SMALL_FLAGS) create --module-version $(VERSION_SHORT) \
         --target-platform '$(JMOD_TARGET_PLATFORM)' \
         --module-path $(JMODS_DIR) $(JMOD_FLAGS) \
         --date $(SOURCE_DATE_ISO_8601) \
diff --git a/make/Images.gmk b/make/Images.gmk
index 9243b15faa0..8a1547507e4 100644
--- a/make/Images.gmk
+++ b/make/Images.gmk
@@ -73,7 +73,7 @@ JLINK_ORDER_RESOURCES += \
     /jdk.localedata/** \
     #
 
-JLINK_TOOL := $(JLINK) -J-Djlink.debug=true \
+JLINK_TOOL := JAVA_TOOL_OPTIONS=--module-path=/usr/share/java/bouncycastle-fips $(JLINK) -J-Djlink.debug=true \
     --module-path $(call PathList, $(JMODS_DIRS)) \
     --endian $(OPENJDK_TARGET_CPU_ENDIAN) \
     --release-info $(BASE_RELEASE_FILE) \
-- 
2.51.0

