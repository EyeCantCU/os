# This security file can be used to opt-out of approved_only usage of
# bc-fips. This will allow access to both approved and certified
# algorithms implemented in the bc-fips libraries, as well as
# unapproved usage (small key sizes, deprecated padding options, not
# yet approved algorithms, etc) see security policy for available
# unapproved algorithms.
#
# Usage options:
# * Pass as a jre image argument i.e.:
#   -Djava.security.properties=/usr/lib/jvm/jdk-fips-config/unapproved.java.security -jar ...
#
# * Or set an environment variable:
#   JAVA_TOOL_OPTIONS='--module-path=/usr/share/java/bouncycastle-fips -Djava.security.properties=/usr/lib/jvm/jdk-fips-config/unapproved.java.security'
org.bouncycastle.fips.approved_only=false
