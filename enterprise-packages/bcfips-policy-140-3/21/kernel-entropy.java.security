# This security file can be used to opt-out of bc-rng-jent userspace
# certified entropy sournce, and instead use kernel provided entropy.
# The strength of keys generated is affected by the available entropy.
#
# Usage options:
# * Pass as a jre image argument i.e.:
#   -Djava.security.properties=/usr/lib/jvm/jdk-fips-config/kernel-entropy.java.security -jar ...
#
# * Or set an environment variable:
#   JAVA_TOOL_OPTIONS='--module-path=/usr/share/java/bouncycastle-fips -Djava.security.properties=/usr/lib/jvm/jdk-fips-config/kernel-entropy.java.security'
security.provider.1=org.bouncycastle.jcajce.provider.BouncyCastleFipsProvider C:DEFRND[SHA256];ENABLE{ALL};
securerandom.source=file:/dev/random
securerandom.strongAlgorithms=NativePRNGBlocking:SUN,DRBG:SUN
securerandom.drbg.config=
