Description: This patch is necessary to fix an FTBFS with glibc 2.43.
 It is an adjusted version of https://gitlab.archlinux.org/archlinux/packaging/packages/firefox/-/blob/main/0003-Patch-glsl-optimizer-to-build-with-glibc-2.43.patch

Index: firefox-140.8.0/Cargo.lock
===================================================================
--- firefox-140.8.0.orig/Cargo.lock
+++ firefox-140.8.0/Cargo.lock
@@ -2771,8 +2771,6 @@ dependencies = [
 [[package]]
 name = "glslopt"
 version = "0.1.11"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "913662ae8335df058d56e00f11340b20fa82e03e0276587797ef325ab01e50d4"
 dependencies = [
  "cc",
 ]
Index: firefox-140.8.0/supply-chain/config.toml
===================================================================
--- firefox-140.8.0.orig/supply-chain/config.toml
+++ firefox-140.8.0/supply-chain/config.toml
@@ -76,6 +76,10 @@ notes = "Used for testing."
 dependency-criteria = { tokio-reactor = [], tokio-threadpool = [] }
 notes = "The dependencies on tokio-reactor and tokio-threadpools are just a hack to pin the version used by audioipc-{client,server}. Suppress vetting on those for the same reasons behind the policy entries."
 
+[policy.glslopt]
+audit-as-crates-io = true
+notes = "Patched version of upstream"
+
 [policy.gluesmith]
 criteria = "safe-to-run"
 notes = "Used for fuzzing."
Index: firefox-140.8.0/build/rust/glslopt/glsl-optimizer/include/c11/threads_posix.h
===================================================================
--- firefox-140.8.0.orig/build/rust/glslopt/glsl-optimizer/include/c11/threads_posix.h
+++ firefox-140.8.0/build/rust/glslopt/glsl-optimizer/include/c11/threads_posix.h
@@ -47,11 +47,16 @@ Configuration macro:
 #define EMULATED_THREADS_USE_NATIVE_TIMEDLOCK
 #endif
 
+#ifndef ONCE_FLAG_INIT
+#define ONCE_FLAG_USE_PTHREAD_ONCE
+#endif
 
 #include <pthread.h>
 
 /*---------------------------- macros ----------------------------*/
+#ifdef ONCE_FLAG_USE_PTHREAD_ONCE
 #define ONCE_FLAG_INIT PTHREAD_ONCE_INIT
+#endif
 #ifdef INIT_ONCE_STATIC_INIT
 #define TSS_DTOR_ITERATIONS PTHREAD_DESTRUCTOR_ITERATIONS
 #else
@@ -66,7 +71,9 @@ typedef pthread_cond_t  cnd_t;
 typedef pthread_t       thrd_t;
 typedef pthread_key_t   tss_t;
 typedef pthread_mutex_t mtx_t;
+#ifdef ONCE_FLAG_USE_PTHREAD_ONCE
 typedef pthread_once_t  once_flag;
+#endif
 
 /*
 Implementation limits:
@@ -90,11 +96,13 @@ impl_thrd_routine(void *p)
 
 /*--------------- 7.25.2 Initialization functions ---------------*/
 // 7.25.2.1
+#ifdef ONCE_FLAG_USE_PTHREAD_ONCE
 static inline void
 call_once(once_flag *flag, void (*func)(void))
 {
     pthread_once(flag, func);
 }
+#endif
 
 
 /*------------- 7.25.3 Condition variable functions -------------*/
Index: firefox-140.8.0/Cargo.toml
===================================================================
--- firefox-140.8.0.orig/Cargo.toml
+++ firefox-140.8.0/Cargo.toml
@@ -239,6 +239,9 @@ plist = { path = "build/rust/plist
 # Patch `unicode-width` 0.1.* to 0.2.
 unicode-width = { path = "build/rust/unicode-width" }
 
