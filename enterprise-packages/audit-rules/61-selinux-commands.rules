##==============================================================================
## Execution of SELinux Commands - MAC-policy
##==============================================================================
## Monitor SELinux mandatory access control policy changes

-a always,exit -F path=/usr/bin/chcon -F auid>=1000 -F auid!=unset -F key=MAC-policy
-a always,exit -F path=/usr/sbin/semanage -F auid>=1000 -F auid!=unset -F key=MAC-policy
-a always,exit -F path=/usr/sbin/setfiles -F auid>=1000 -F auid!=unset -F key=MAC-policy
-a always,exit -F path=/usr/sbin/setsebool -F auid>=1000 -F auid!=unset -F key=MAC-policy
