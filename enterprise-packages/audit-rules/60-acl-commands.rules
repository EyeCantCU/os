##==============================================================================
## Execution of ACL Commands - perm_chng
##==============================================================================
## Monitor execution of commands that change ACLs (Access Control Lists)

-a always,exit -F path=/usr/bin/chacl -F auid>=1000 -F auid!=unset -F key=perm_chng
-a always,exit -F path=/usr/bin/setfacl -F auid>=1000 -F auid!=unset -F key=perm_chng
