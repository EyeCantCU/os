From 62c188b0a06e25991db4e37a822f5413e790cada Mon Sep 17 00:00:00 2001
From: Alex Leong <alex@buoyant.io>
Date: Tue, 28 Oct 2025 00:28:22 +0000
Subject: [PATCH] remove square brackets from host which may not be ipv6 in
 kubeconfig

Signed-off-by: Alex Leong <alex@buoyant.io>
---
 cni-plugin/deployment/scripts/install-cni.sh | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/cni-plugin/deployment/scripts/install-cni.sh b/cni-plugin/deployment/scripts/install-cni.sh
index c6310bd3..7b516b66 100755
--- a/cni-plugin/deployment/scripts/install-cni.sh
+++ b/cni-plugin/deployment/scripts/install-cni.sh
@@ -157,7 +157,7 @@ kind: Config
 clusters:
 - name: local
   cluster:
-    server: ${KUBERNETES_SERVICE_PROTOCOL:-https}://[${KUBERNETES_SERVICE_HOST}]:${KUBERNETES_SERVICE_PORT}
+    server: ${KUBERNETES_SERVICE_PROTOCOL:-https}://${KUBERNETES_SERVICE_HOST}:${KUBERNETES_SERVICE_PORT}
     ${TLS_CFG}
 users:
 - name: linkerd-cni
