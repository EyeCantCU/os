# AWS ENA https://docs.aws.amazon.com/AWSEC2/latest/UserGuide/enhanced-networking-ena.html
CONFIG_NET_VENDOR_AMAZON=y
CONFIG_ENA_ETHERNET=m

# AMD IOMMU
CONFIG_AMD_IOMMU=y

# Intel 82599 VF https://docs.aws.amazon.com/AWSEC2/latest/UserGuide/sriov-networking.html
CONFIG_NET_VENDOR_I825XX=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_IXGBE=m
CONFIG_IXGBE_DCB=y
CONFIG_IXGBEVF=m
CONFIG_IXGBEVF_IPSEC=y

# AWS Nitro Enclaves
CONFIG_NITRO_ENCLAVES=m
CONFIG_NSM=m
