#!/bin/sh

main() {
    echo "Starting modprobe test."
    trap 'echo "Finished modprobe test."' EXIT

    modprobe="$1"
    modname="$2"
    want_err="$3"
    [ -z "$modname" ] && modname="$modprobe"

    echo "Testing modprobe of: $modprobe"
    if [ "$want_err" = "" ]; then
      echo "Checking that: $modname is loaded"
      echo "Expecting no errors"
    else
      echo "Expecting modprobe to fail with '$want_err'"
    fi

    modprobe_out=$(modprobe "$modprobe" 2>&1)
    modprobe_rc=$?
    if [ "$want_err" = "" ]; then
      if [ "$modprobe_rc" = "0" ]; then
          echo "MODPROBE_LOAD: PASS"
      else
          echo "MODPROBE_LOAD: FAIL"
          echo "modprobe [$modprobe_rc]: $modprobe_out"
          exit 1
      fi
    else
      if echo "$modprobe_out" | grep -q "$want_err"; then
          echo "MODPROBE_LOAD: PASS"
          echo "Module failed with the right error, skipping unload test."
          exit 0
      else
          echo "MODPROBE_LOAD: FAIL"
          echo "modprobe [$modprobe_rc]: $modprobe_out"
          exit 1
      fi
    fi

    # Verify the module is loaded
    if lsmod | grep -q "^$modname"; then
        echo "MODULE_LOADED: PASS"
    else
        echo "MODULE_LOADED: FAIL"
        echo "lsmod: $(lsmod)"
        exit 1
    fi

    # Test unloading the module
    echo "Unloading module: $modprobe"
    if modprobe -r "$modprobe"; then
        echo "MODPROBE_UNLOAD: PASS"
    else
        echo "MODPROBE_UNLOAD: FAIL"
        exit 1
    fi

    # Verify the module is unloaded
    if ! lsmod | grep -q "^$modname"; then
        echo "MODULE_UNLOADED: PASS"
    else
        echo "MODULE_UNLOADED: FAIL"
        echo "lsmod: $(lsmod)"
        exit 1
    fi

    echo "MODPROBE_TEST: PASS"
}

main "$@"
