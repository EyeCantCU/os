+package org.elasticsearch.common.settings;
+
+/**
+ * Configuration for the Elasticsearch keystore password.
+ * Returns the password from the KEYSTORE_PASSWORD environment variable,
+ * falling back to a BCFIPS-compliant default.
+ */
+public final class KeyStoreConfig {
+
+    private static final String DEFAULT_PASSWORD = "changeitchangeit";
+
+    private KeyStoreConfig() {}
+
+    public static char[] getPasswordChars() {
+        String password = System.getenv("KEYSTORE_PASSWORD");
+        if (password == null || password.isBlank()) {
+            password = DEFAULT_PASSWORD;
+        }
+        return password.toCharArray();
+    }
+}
