 import org.elasticsearch.cli.Terminal;
 import org.elasticsearch.cli.UserException;
 import org.elasticsearch.common.cli.KeyStoreAwareCommand;
+import org.elasticsearch.common.settings.KeyStoreConfig;
 import org.elasticsearch.common.settings.KeyStoreWrapper;
 import org.elasticsearch.common.settings.SecureString;
 import org.elasticsearch.env.Environment;
@@ -37,15 +38,23 @@ class CreateKeyStoreCommand extends KeyStoreAwareCommand {
         this.passwordOption = parser.acceptsAll(Arrays.asList("p", "password"), "Prompt for password to encrypt the keystore");
     }
 
+    // This file must exist after init keystore creation or ECK operator will attempt to recreate the keystore
+    private static final String ECK_INIT_KEYSTORE_FLAG = "elastic-internal-init-keystore.ok";
+
     @Override
     public void execute(Terminal terminal, OptionSet options, Environment env, ProcessInfo processInfo) throws Exception {
-        try (SecureString password = options.has(passwordOption) ? readPassword(terminal, true) : new SecureString(new char[0])) {
+        final char[] passwordChars = KeyStoreConfig.getPasswordChars();
+        try (SecureString password = options.has(passwordOption) ? readPassword(terminal, true) : new SecureString(passwordChars)) {
             Path keystoreFile = KeyStoreWrapper.keystorePath(env.configDir());
             if (Files.exists(keystoreFile)) {
                 if (terminal.promptYesNo("An elasticsearch keystore already exists. Overwrite?", false) == false) {
                     terminal.println("Exiting without creating keystore.");
                     return;
                 }
+            } else {
+                Path flagFile = env.configDir().resolve(ECK_INIT_KEYSTORE_FLAG);
+                Files.createDirectories(flagFile.getParent());
+                Files.writeString(flagFile, "");
             }
             KeyStoreWrapper keystore = KeyStoreWrapper.create();
             keystore.save(env.configDir(), password.getChars());
