harden_stig_systemd_coredump()
{
	sed -i "s|^#?*Storage.*|Storage=none|g" "${sysroot}/etc/systemd/coredump.conf"
	sed -i "s|^#?*ProcessSizeMax.*|ProcessSizeMax=0|g" "${sysroot}/etc/systemd/coredump.conf"
	ln -sf /dev/null "${sysroot}/etc/systemd/system/systemd-coredump.socket"
