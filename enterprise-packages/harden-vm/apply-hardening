}

harden_stig_faillock()
{
	sed -i 's|^# dir = .*|dir = /var/log/faillock|' "${sysroot}/etc/security/faillock.conf"
	sed -i 's/^# audit/audit/' "${sysroot}/etc/security/faillock.conf"
	sed -i 's/^# deny = .*/deny = 3/' "${sysroot}/etc/security/faillock.conf"
	sed -i 's/^# even_deny_root/even_deny_root/' "${sysroot}/etc/security/faillock.conf"
	sed -i 's/^# fail_interval.*/fail_interval = 900/' "${sysroot}/etc/security/faillock.conf"
	sed -i 's/^# unlock_time.*/unlock_time = 0/' "${sysroot}/etc/security/faillock.conf"
}

harden_stig_logindefs()
{
	echo "PASS_MAX_DAYS 60" >> "${sysroot}/etc/login.defs"
	echo "PASS_MIN_DAYS 1" >> "${sysroot}/etc/login.defs"
	echo "ENCRYPT_METHOD SHA512" >> "${sysroot}/etc/login.defs"
	echo "FAIL_DELAY 4" >> "${sysroot}/etc/login.defs"
	echo "CREATE_HOME yes" >> "${sysroot}/etc/login.defs"
	echo "UMASK 077" >> "${sysroot}/etc/login.defs"
}

harden_stig_limits()
{
	echo "* hard maxlogins 10" >> "${sysroot}/etc/security/limits.conf"
	echo "* hard core 0" >> "${sysroot}/etc/security/limits.conf"
}

harden_stig_selinux_sudo()
{
	cat << "EOF" > "${sysroot}/etc/sudoers.d/11-stig-selinux.conf"
%wheel ALL=(ALL) TYPE=sysadm_t ROLE=sysadm_r ALL
EOF
}

harden_stig()
{
	harden_stig_sshd
	harden_stig_mount_options
	harden_stig_login_banners
	harden_stig_sysctl
	harden_stig_kmods
	harden_stig_systemd_target
	harden_stig_pam
	harden_stig_systemd_ctrlaltdel
	harden_stig_systemd_coredump
	harden_stig_fixnews
	harden_stig_faillock
	harden_stig_logindefs
	harden_stig_limits
	harden_stig_selinux_sudo
}

main()
{
	local short_opts='h'
	local long_opts='help,profile:,sysroot:,runtime-remediate'
	local getopt_out

	if getopt_out=$(getopt --name "${0##*/}" --options "${short_opts}" --long "${long_opts}" -- "$@"); then
		eval set -- "${getopt_out}"
	else
		Usage 1>&2
		exit 1
	fi

	# Intentionally global
	profile=
	sysroot=/
	runtime_remediate=no

	while [[ $# -ne 0 ]]; do
		cur=$1
		next=$2
		case ${cur} in
			-h | --help)
				usage
				exit 0
				;;
			--profile)
				profile=${next}
				shift
				;;
			--sysroot)
				sysroot=${next}
				shift
				;;
			--runtime-remediate)
				runtime_remediate=yes
				;;
		esac
		shift
	done

	[[ -z ${profile} ]] && bad_usage 'require a --profile to be given'

	sysroot=${sysroot%%/}

	case ${profile} in
		cis-level-1)
			harden_cis_level_1
			;;
		stig)
			harden_stig
			;;
		*)
			bail "invalid --profile '${profile}', valid profiles are 'cis-level-1' or 'stig'"
			;;
	esac
}

main "$@"
