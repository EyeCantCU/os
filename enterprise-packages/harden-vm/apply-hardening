apply_pwquality_config()
{
	local -r option=$1 value=$2

	local -r pwquality_config="${sysroot}/etc/security/pwquality.conf"
	local -r expected="${option} = ${value}"

	sed -Ei "s|^#\s*?${option}\s.*|${expected}|" "${pwquality_config}"
	if grep -Eq "^${expected}$" "${pwquality_config}"; then
		return 0
	fi

	printf '%s\n' "${expected}" >> "${pwquality_config}"
}

harden_stig_pam()
{
	declare -Ar pwconfigs=(
		[retry]=3
		[dcredit]=-1
		[dictcheck]=1
		[difok]=8
		[lcredit]=-1
		[maxclassrepeat]=4
		[maxrepeat]=3
		[minclass]=4
		[minlen]=15
		[ocredit]=-1
		[ucredit]=-1
	)

	for option in "${!pwconfigs[@]}"; do
		local value=${pwconfigs[${option}]}
		if ! apply_pwquality_config "${option}" "${value}"; then
			bail "Failed to configure pwquality with '${option} ${value}'"
		fi
	done

	sed -i "s|^# enforce_for_root|enforce_for_root|g" "${sysroot}/etc/security/pwquality.conf"

	sed -i '/^auth.*sufficient.*pam_rootok.so/a auth required pam_wheel.so use_uid' "${sysroot}/etc/pam.d/su"

	sed -i '/^auth.*sufficient.*pam_rootok.so/a auth required pam_wheel.so use_uid' "${sysroot}/etc/pam.d/su"
	for i in base-password base-auth base-account; do
		sed -i '/^password required/i password requisite pam_pwquality.so' "${sysroot}/etc/pam.d/$i"
		sed -i 's|nullok||g' "${sysroot}/etc/pam.d/$i"
		sed -i 's/^\(password.*pam_unix\.so.*\)$/\1 rounds=100000/' "${sysroot}/etc/pam.d/$i"
		sed -i 's/^password.*required.*pam_unix\.so/password sufficient pam_unix.so/' "${sysroot}/etc/pam.d/$i"
		if ! grep -q pam_faillock.so "${sysroot}/etc/pam.d/$i"; then
			echo 'auth        required      pam_faillock.so preauth silent' >> "${sysroot}/etc/pam.d/$i"
			echo 'auth        sufficient    pam_unix.so try_first_pass' >> "${sysroot}/etc/pam.d/$i"
			echo 'auth        required      pam_faillock.so authfail' >> "${sysroot}/etc/pam.d/$i"
			echo 'account     required      pam_faillock.so' >> "${sysroot}/etc/pam.d/$i"
			echo 'account     required      pam_unix.so' >> "${sysroot}/etc/pam.d/$i"
		fi
	done
	# TODO: fix the benchmark to search our own paths
	ln -sf /etc/pam.d/base-password "${sysroot}/etc/pam.d/password-auth"
	ln -sf /etc/pam.d/base-password "${sysroot}/etc/pam.d/system-auth"

	cat > "${sysroot}/etc/pam.d/postlogin" << 'EOF'
#%PAM-1.0
# Display last login/logon information
session     optional      pam_lastlog.so showfailed
EOF
}

harden_stig_systemd_ctrlaltdel()
{
	sed -i "s|^#?*CtrlAltDelBurstAction.*|CtrlAltDelBurstAction=none|g" "${sysroot}/etc/systemd/system.conf"
	ln -sf /dev/null "${sysroot}/etc/systemd/system/ctrl-alt-del.target"
	ln -sf /dev/null "${sysroot}/etc/systemd/system/debug-shell.service"
