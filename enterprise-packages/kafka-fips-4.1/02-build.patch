# Add FIPS BouncyCastle as runtime dependencies in the clients module.
# Upstream only includes bcpkix as a testImplementation dependency;
# FIPS mode requires these libraries at runtime for SSL/TLS operations.
diff --git a/build.gradle b/build.gradle
index 9725063..d45028c 100644
--- a/build.gradle
+++ b/build.gradle
@@ -1810,6 +1810,11 @@ project(':clients') {
     implementation libs.protobuf
     implementation libs.slf4jApi
 
+    // FIPS BouncyCastle providers
+    implementation libs.bcfips
+    implementation libs.bcpkix
+    implementation libs.bctls
+
     // libraries which should be added as runtime dependencies in generated pom.xml should be defined here:
     shadowed libs.zstd
     shadowed libs.lz4
@@ -1822,7 +1827,6 @@ project(':clients') {
 
 
     testImplementation project(':test-common:test-common-util')
-    testImplementation libs.bcpkix
     testImplementation libs.jacksonJakartarsJsonProvider
     testImplementation libs.jose4j
     testImplementation libs.junitJupiter
