--- clickhouse-orig/programs/keeper/keeper_main.cpp	2026-01-06 10:03:32.889711357 -0500
+++ clickhouse-new/programs/keeper/keeper_main.cpp	2026-01-06 10:05:43.307219350 -0500
@@ -1,5 +1,6 @@
