From 99095a17bd044d98b4015bdba11946c20e091915 Mon Sep 17 00:00:00 2001
From: Pieter Lexis <pieter.lexis@powerdns.com>
Date: Mon, 9 Feb 2026 09:36:15 +0100
Subject: [PATCH] docs(auth): Pin setuptools so pkg_resources keeps working

Origin: backport, https://github.com/PowerDNS/pdns/commit/f3e4710c509ea70e3a4368d3d1f5b4138b05f0b0
---
 docs/Makefile.am      |  2 +-
 docs/Makefile.sphinx  |  2 +-
 docs/requirements.in  |  1 +
 docs/requirements.txt | 15 ++++++++++-----
 pdns/Makefile.am      |  2 +-
 5 files changed, 14 insertions(+), 8 deletions(-)

diff --git a/docs/Makefile.am b/docs/Makefile.am
index 9db391243..5a17aef4c 100644
--- a/docs/Makefile.am
+++ b/docs/Makefile.am
@@ -68,7 +68,7 @@ mans/.complete: .venv
 
 .venv: requirements.txt
 	$(PYTHON) -m venv .venv
-	.venv/bin/pip install -U pip setuptools setuptools-git wheel
+	.venv/bin/pip install -U pip "setuptools<82" setuptools-git wheel
 	.venv/bin/pip install -r requirements.txt
 
 .NOTPARALLEL: \
diff --git a/docs/Makefile.sphinx b/docs/Makefile.sphinx
index ea1663aa7..ba0ce19d8 100644
--- a/docs/Makefile.sphinx
+++ b/docs/Makefile.sphinx
@@ -21,5 +21,5 @@ help: .venv
 
 .venv:
 	python3 -m venv .venv
-	.venv/bin/pip install -U pip setuptools setuptools-git wheel
+	.venv/bin/pip install -U pip "setuptools<82" setuptools-git wheel
 	.venv/bin/pip install -r requirements.txt
diff --git a/docs/requirements.in b/docs/requirements.in
index 273a5e69a..a85223665 100644
--- a/docs/requirements.in
+++ b/docs/requirements.in
@@ -10,3 +10,4 @@ guzzle_sphinx_theme
 docutils!=0.15,<0.18
 jinja2<3.1.0
 pyyaml==6.0.1
+setuptools<82
diff --git a/docs/requirements.txt b/docs/requirements.txt
index c0a05ffa6..6b8e102fa 100644
--- a/docs/requirements.txt
+++ b/docs/requirements.txt
@@ -2,7 +2,7 @@
 # This file is autogenerated by pip-compile with Python 3.11
 # by the following command:
 #
-#    pip-compile --generate-hashes requirements.in
+#    pip-compile --allow-unsafe --generate-hashes requirements.in
 #
 alabaster==0.7.13 \
     --hash=sha256:1ee19aca801bbabb5ba3f5f258e4422dfa86f82f3e9cefb0859b283cdd7f62a3 \
@@ -321,7 +321,12 @@ urllib3==2.0.3 \
     --hash=sha256:bee28b5e56addb8226c96f7f13ac28cb4c301dd5ea8a6ca179c0b9835e032825
     # via requests
 
-# WARNING: The following packages were not pinned, but pip requires them to be
-# pinned when the requirements file includes hashes and the requirement is not
-# satisfied by a package already installed. Consider using the --allow-unsafe flag.
-# setuptools
+# The following packages are considered to be unsafe in a requirements file:
+setuptools==81.0.0 \
+    --hash=sha256:487b53915f52501f0a79ccfd0c02c165ffe06631443a886740b91af4b7a5845a \
+    --hash=sha256:fdd925d5c5d9f62e4b74b30d6dd7828ce236fd6ed998a08d81de62ce5a6310d6
+    # via
+    #   -r requirements.in
+    #   pbr
+    #   setuptools-scm
+    #   sphinx
diff --git a/pdns/Makefile.am b/pdns/Makefile.am
index 7b1bef6b8..63fdcce17 100644
--- a/pdns/Makefile.am
+++ b/pdns/Makefile.am
@@ -102,7 +102,7 @@ api-swagger.yaml: $(wildcard ../docs/http-api/swagger/authoritative-api-swagger.
 if HAVE_VENV
 api-swagger.json: api-swagger.yaml requirements.txt
 	$(PYTHON) -m venv .venv
-	.venv/bin/pip install -U pip setuptools setuptools-git wheel
+	.venv/bin/pip install -U pip "setuptools<82" setuptools-git wheel
 	.venv/bin/pip install -r requirements.txt
 	.venv/bin/python convert-yaml-to-json.py $< $@
 else # if HAVE_VENV
-- 
2.43.0

