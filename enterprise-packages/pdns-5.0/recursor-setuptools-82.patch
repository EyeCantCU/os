From 8e7ba424c1770deb2dc5e7baa1688c86c5ace378 Mon Sep 17 00:00:00 2001
From: Pieter Lexis <pieter.lexis@powerdns.com>
Date: Mon, 9 Feb 2026 09:35:52 +0100
Subject: [PATCH] docs(recursor): Pin setuptools so pkg_resources keeps working

Origin: backport, https://github.com/PowerDNS/pdns/commit/81b11cc4cfdad5843d12dd6bb271990a2a49da86
---
 pdns/recursordist/Makefile.am           | 2 +-
 pdns/recursordist/docs/Makefile.sphinx  | 2 +-
 pdns/recursordist/docs/requirements.txt | 1 +
 3 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/pdns/recursordist/Makefile.am b/pdns/recursordist/Makefile.am
index 286091ea7..704ab0075 100644
--- a/pdns/recursordist/Makefile.am
+++ b/pdns/recursordist/Makefile.am
@@ -553,7 +553,7 @@ endif # if !HAVE_MANPAGES
 
 .venv: docs/requirements.txt
 	$(PYTHON) -m venv .venv
-	.venv/bin/pip install -U pip setuptools setuptools-git wheel
+	.venv/bin/pip install -U pip "setuptools<82" setuptools-git wheel
 	.venv/bin/pip install -r docs/requirements.txt
 
 html-docs: docs/** .venv
diff --git a/pdns/recursordist/docs/Makefile.sphinx b/pdns/recursordist/docs/Makefile.sphinx
index c093fd2ef..6122a9a34 100644
--- a/pdns/recursordist/docs/Makefile.sphinx
+++ b/pdns/recursordist/docs/Makefile.sphinx
@@ -21,7 +21,7 @@ help: .venv
 
 .venv:
 	python3 -m venv .venv
-	.venv/bin/pip install -U pip setuptools setuptools-git wheel
+	.venv/bin/pip install -U pip "setuptools<82" setuptools-git wheel
 	.venv/bin/pip install -r requirements.txt
 
 
diff --git a/pdns/recursordist/docs/requirements.txt b/pdns/recursordist/docs/requirements.txt
index 08f7ee915..9b0c7d362 100644
--- a/pdns/recursordist/docs/requirements.txt
+++ b/pdns/recursordist/docs/requirements.txt
@@ -8,3 +8,4 @@ sphinxcontrib-fulltoc
 docutils!=0.15,<0.18
 jinja2<3.1.0
 alabaster==0.7.13
+setuptools<82
-- 
2.43.0

