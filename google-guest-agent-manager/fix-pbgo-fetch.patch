From 25e5d4f2aff5f1bf04114d6b52a11136636dce31 Mon Sep 17 00:00:00 2001
From: Debasish Biswas <debasishbsws.dev@gmail.com>
Date: Fri, 24 Oct 2025 20:03:42 +0530
Subject: [PATCH] These 'git pull' invocations will operate on the parent
 repository, meaning 'git clone' won't be called reliably.

Signed-off-by: Debasish Biswas <debasishbsws.dev@gmail.com>
---
 build/Makefile.gobin | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/build/Makefile.gobin b/build/Makefile.gobin
index cede955..a8e5559 100644
--- a/build/Makefile.gobin
+++ b/build/Makefile.gobin
@@ -31,14 +31,14 @@ fetch-go-tpm-tools:
 	$(Q)echo "Making proto dependencies dir..."
 	$(Q)mkdir -p proto_deps
 	$(Q)echo "Cloning/updating go-tpm-tools..."
-	$(Q)git -C proto_deps/go-tpm-tools pull 2> /dev/null || \
+	$(Q)test -d proto_deps/go-tpm-tools/.git || \
 		git clone $(GO_TPM_TOOLS_URL) proto_deps/go-tpm-tools
 
 fetch-mwlid-proto:
 	$(Q)echo "Making proto dependencies dir..."
 	$(Q)mkdir -p proto_deps
 	$(Q)echo "Cloning/updating mwlid-proto..."
-	$(Q)git -C proto_deps/mwlid pull 2> /dev/null || \
+	$(Q)test -d proto_deps/mwlid/.git || \
 		git clone $(MWLID_PROTO_URL) proto_deps/mwlid
 	$(Q)mkdir -p cmd/core_plugin/workloadcertrefresh/proto
 	$(Q)cp proto_deps/mwlid/proto/v1/workload-identity.proto cmd/core_plugin/workloadcertrefresh/proto/workload_identity.proto
-- 
