From cdec83e3895efb2816172abd159e354596dc1ea7 Mon Sep 17 00:00:00 2001
From: Azimjon Ulmasov <azimjon.ulmasov@chainguard.dev>
Date: Tue, 24 Jun 2025 13:59:41 -0400
Subject: [PATCH] build.sh: Removes the bundled "python3 setup.py bdist_wheel" call to use our in-house pipeline 
"pip-build-install.yaml"

Signed-off-by: Azimjon Ulmasov <azimjon.ulmasov@chainguard.dev>
---
 python/build.sh | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/TensorRT/python/build.sh b/TensorRT/python/build.sh
index 44d19334..d35d66af 100755
--- a/TensorRT/python/build.sh
+++ b/TensorRT/python/build.sh
@@ -67,7 +67,3 @@ popd

-pushd ${WHEEL_OUTPUT_DIR}/bindings_wheel
-python3 setup.py -q bdist_wheel --python-tag=cp${PYTHON_MAJOR_VERSION}${PYTHON_MINOR_VERSION} --plat-name=linux_${TARGET}
-
-popd
