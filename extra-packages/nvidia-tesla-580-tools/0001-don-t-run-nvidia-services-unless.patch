From 601b918242f48cbc0671961af8444ebc6ff498f2 Mon Sep 17 00:00:00 2001
From: Amelia Crate <amelia.crate@chainguard.dev>
Date: Fri, 16 Jan 2026 11:32:19 -0600
Subject: [PATCH] don't run nvidia services unless nvidia module is loaded

---
 systemd/system/nvidia-hibernate.service              | 1 +
 systemd/system/nvidia-powerd.service                 | 1 +
 systemd/system/nvidia-resume.service                 | 1 +
 systemd/system/nvidia-suspend-then-hibernate.service | 1 +
 systemd/system/nvidia-suspend.service                | 1 +
 5 files changed, 5 insertions(+)

diff --git a/systemd/system/nvidia-hibernate.service b/systemd/system/nvidia-hibernate.service
index 9a137bc..49a8e0e 100644
--- a/systemd/system/nvidia-hibernate.service
+++ b/systemd/system/nvidia-hibernate.service
@@ -1,6 +1,7 @@
 [Unit]
 Description=NVIDIA system hibernate actions
 Before=systemd-hibernate.service
+ConditionPathExists=/sys/module/nvidia
 
 [Service]
 Type=oneshot
diff --git a/systemd/system/nvidia-powerd.service b/systemd/system/nvidia-powerd.service
index 5f4c8c5..783a02f 100644
--- a/systemd/system/nvidia-powerd.service
+++ b/systemd/system/nvidia-powerd.service
@@ -1,5 +1,6 @@
 [Unit]
 Description=nvidia-powerd service
+ConditionPathExists=/sys/module/nvidia
 
 [Service]
 Type=simple
diff --git a/systemd/system/nvidia-resume.service b/systemd/system/nvidia-resume.service
index 8edfc3a..ff3aa46 100644
--- a/systemd/system/nvidia-resume.service
+++ b/systemd/system/nvidia-resume.service
@@ -3,6 +3,7 @@ Description=NVIDIA system resume actions
 After=systemd-suspend.service
 After=systemd-hibernate.service
 After=systemd-suspend-then-hibernate.service
+ConditionPathExists=/sys/module/nvidia
 
 [Service]
 Type=oneshot
diff --git a/systemd/system/nvidia-suspend-then-hibernate.service b/systemd/system/nvidia-suspend-then-hibernate.service
index fbd0597..ca91773 100644
--- a/systemd/system/nvidia-suspend-then-hibernate.service
+++ b/systemd/system/nvidia-suspend-then-hibernate.service
@@ -1,6 +1,7 @@
 [Unit]
 Description=NVIDIA actions for suspend-then-hibernate
 Before=systemd-suspend-then-hibernate.service
+ConditionPathExists=/sys/module/nvidia
 
 [Service]
 Type=oneshot
diff --git a/systemd/system/nvidia-suspend.service b/systemd/system/nvidia-suspend.service
index bd25065..f9b8452 100644
--- a/systemd/system/nvidia-suspend.service
+++ b/systemd/system/nvidia-suspend.service
@@ -1,6 +1,7 @@
 [Unit]
 Description=NVIDIA system suspend actions
 Before=systemd-suspend.service
+ConditionPathExists=/sys/module/nvidia
 
 [Service]
 Type=oneshot
-- 
2.51.2

