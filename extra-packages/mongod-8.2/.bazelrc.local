# Pick optimized profile
common --config=opt
# Do public build without remote build farm
common --config=public-release
# use our toolchains
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=0
# no debug symbols
common --//bazel/config:debug_symbols=False
# no enterprise build
common --//bazel/config:build_enterprise=False
# no warnings as errors
common --//bazel/config:disable_warnings_as_errors=True
# more details about failures
common --verbose_failures
# some portions of mongo need c++20
common --cxxopt='-std=c++20' --host_cxxopt=-std=c++20
common --repo_env=BAZEL_CXXOPTS