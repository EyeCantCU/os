From 12e1b70c135b01cd998c0b99aa2eef3cda7964e7 Mon Sep 17 00:00:00 2001
From: Dimitri John Ledkov <dimitri.ledkov@surgut.co.uk>
Date: Fri, 9 Jan 2026 16:19:49 +0000
Subject: [PATCH] bazelrc - update to c++20

---
 src/third_party/grpc/dist/third_party/utf8_range/.bazelrc     | 2 +-
 src/third_party/protobuf/dist/third_party/utf8_range/.bazelrc | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/third_party/grpc/dist/third_party/utf8_range/.bazelrc b/src/third_party/grpc/dist/third_party/utf8_range/.bazelrc
index aa13acf66a1..85d8a717596 100644
--- a/src/third_party/grpc/dist/third_party/utf8_range/.bazelrc
+++ b/src/third_party/grpc/dist/third_party/utf8_range/.bazelrc
@@ -1,4 +1,4 @@
-build --cxxopt=-std=c++14 --host_cxxopt=-std=c++14
+build --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
 
 build:asan --copt=-fsanitize=address --linkopt=-fsanitize=address
 build:msan --copt=-fsanitize=memory --linkopt=-fsanitize=memory
diff --git a/src/third_party/protobuf/dist/third_party/utf8_range/.bazelrc b/src/third_party/protobuf/dist/third_party/utf8_range/.bazelrc
index aa13acf66a1..85d8a717596 100644
--- a/src/third_party/protobuf/dist/third_party/utf8_range/.bazelrc
+++ b/src/third_party/protobuf/dist/third_party/utf8_range/.bazelrc
@@ -1,4 +1,4 @@
-build --cxxopt=-std=c++14 --host_cxxopt=-std=c++14
+build --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
 
 build:asan --copt=-fsanitize=address --linkopt=-fsanitize=address
 build:msan --copt=-fsanitize=memory --linkopt=-fsanitize=memory
-- 
2.51.0

