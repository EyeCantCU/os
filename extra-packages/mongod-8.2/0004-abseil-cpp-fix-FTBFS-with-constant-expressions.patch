 #include <regex>  // NOLINT
 #include <vector>
 
@@ -73,7 +74,7 @@ struct Policy {
 
   template <class Hash>
   static constexpr auto get_hash_slot_fn() {
-    return nullptr;
+    return std::nullopt;
   }
 };
 
diff --git a/src/third_party/abseil-cpp/dist/absl/container/internal/raw_hash_set_test.cc b/src/third_party/abseil-cpp/dist/absl/container/internal/raw_hash_set_test.cc
index 9a323c41bec..25580cabc9c 100644
--- a/src/third_party/abseil-cpp/dist/absl/container/internal/raw_hash_set_test.cc
