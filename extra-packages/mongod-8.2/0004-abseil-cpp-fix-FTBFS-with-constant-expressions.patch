+    return std::nullopt;
   }
 };
 
@@ -128,8 +129,8 @@ class StringPolicy {
   }
 
   template <class Hash>
-  static constexpr HashSlotFn get_hash_slot_fn() {
-    return nullptr;
+  static constexpr std::optional<HashSlotFn> get_hash_slot_fn() {
+    return std::nullopt;
   }
 };
 
diff --git a/src/third_party/abseil-cpp/dist/absl/container/internal/raw_hash_set_probe_benchmark.cc b/src/third_party/abseil-cpp/dist/absl/container/internal/raw_hash_set_probe_benchmark.cc
