diff --git a/src/third_party/grpc/dist/third_party/toolchains/rbe_ubuntu2004/cc/BUILD b/src/third_party/grpc/dist/third_party/toolchains/rbe_ubuntu2004/cc/BUILD
index 382c574a807..63794cbf2af 100644
