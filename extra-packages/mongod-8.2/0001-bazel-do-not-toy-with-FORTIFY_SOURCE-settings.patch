From 27a669c44c4acddf627a840d7d74181d6f4cfc99 Mon Sep 17 00:00:00 2001
From: Dimitri John Ledkov <dimitri.ledkov@surgut.co.uk>
Date: Wed, 31 Dec 2025 11:28:18 +0000
Subject: [PATCH] bazel: do not toy with FORTIFY_SOURCE settings

Multiple (re-)declarations of FORTIFY_SOURCE can cause errors and
build failures.

Our mongo builds are optimisized and declare FORTIFY_SOURCE in the
hardening-flags already, thus remove all attempts to set/unset
FORITY_SOURCE.
---
 .../mongo_apple_llvm_cc_toolchain_config.bzl      | 15 ---------------
 bazel/toolchains/cc/mongo_defines.bzl             |  9 ---------
 .../mongo_linux_cc_toolchain_config.bzl           | 15 ---------------
 .../toolchains/rbe_ubuntu2004/cc/BUILD            |  1 -
 .../rbe_ubuntu2004/cc/cc_toolchain_config.bzl     | 15 ---------------
 5 files changed, 55 deletions(-)

diff --git a/bazel/toolchains/cc/mongo_apple/mongo_apple_llvm_cc_toolchain_config.bzl b/bazel/toolchains/cc/mongo_apple/mongo_apple_llvm_cc_toolchain_config.bzl
index 4acd7d5708c..73ce783b61e 100644
--- a/bazel/toolchains/cc/mongo_apple/mongo_apple_llvm_cc_toolchain_config.bzl
+++ b/bazel/toolchains/cc/mongo_apple/mongo_apple_llvm_cc_toolchain_config.bzl
@@ -318,21 +318,6 @@ def _impl(ctx):
         name = "default_compile_flags",
         enabled = True,
         flag_sets = [
-            flag_set(
-                actions = all_compile_actions,
-                flag_groups = [
-                    flag_group(
-                        # Security hardening requires optimization.
-                        # We need to undef it as some distributions now have it enabled by default.
-                        flags = ["-U_FORTIFY_SOURCE"],
-                    ),
-                ],
-                with_features = [
-                    with_feature_set(
-                        not_features = ["thin_lto"],
-                    ),
-                ],
-            ),
             flag_set(
                 actions = all_compile_actions,
                 flag_groups = ([
