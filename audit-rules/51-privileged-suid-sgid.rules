##==============================================================================
## SUID/SGID Privilege Function Execution - privileged-function
##==============================================================================
## Monitor when users execute programs with elevated privileges via SUID/SGID

## 64-bit architecture
-a always,exit -F arch=b64 -S execve -C uid!=euid -F euid=0 -F auid>=1000 -F auid!=unset -F key=privileged-function
-a always,exit -F arch=b64 -S execve -C gid!=egid -F egid=0 -F auid>=1000 -F auid!=unset -F key=privileged-function
-a always,exit -F arch=b32 -S execve -C gid!=egid -F egid=0 -k setgid
-a always,exit -F arch=b32 -S execve -C uid!=euid -F euid=0 -k setuid
-a always,exit -F arch=b64 -S execve -C gid!=egid -F egid=0 -k setgid
-a always,exit -F arch=b64 -S execve -C uid!=euid -F euid=0 -k setuid
