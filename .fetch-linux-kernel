#!/bin/sh

set -e

usage() {
	echo "
$0 [-a|--arch x86_64|aarch64] [-v|--version x.y.z-r*] [-l|--list]

 -a|--arch [x86_64|aarch64]	Linux kernel architecture; defaults to your current system architecture per 'uname -m'
 -l|--list			List Linux kernel versions available
 -v|--version [x.y.z-r*]	Linux kernel version

"
	exit 0
}

error() {
	echo "ERROR: $@" 1>&2
	exit 1
}

# Default to current system architecture
arch=$(uname -m)
dir=$(dirname "$0")
while [ ! -z "$1" ]; do
	case "$1" in
		-a|--arch)
			case "$2" in
				x86_64|aarch64)
					arch="$2"
				;;
				*)
					error "Arch must be x86_64 or aarch64"
				;;
			esac
			shift 2
		;;
		-l|--list)
			list=1
			shift 1
		;;
		-v|--version)
			[ -z "${2}" ] && \
				{ echo "Version must be specified"; usage; exit 1; }
			ver="$2"
			shift 2
		;;
		-h|--help)
			usage
			exit 0
		;;
		*)
			usage
			exit 1
		;;
	esac
done

# List kernel versions available and exit
if [ "$list" = "1" ]; then
	curl -L --silent --output - --user user:$(chainctl auth token --audience apk.cgr.dev) https://apk.cgr.dev/chainguard-private/$arch/APKINDEX.tar.gz | \
		zcat | \
		grep -a -A1 "^P:linux" | \
		grep "^V:" | \
		sort -V | \
		sed -e "s/^V://"
	exit 0
fi

# Fetch the package list, grep for the linux package, and find the latest version
[ -z "$ver" ] && ver=$(curl -L --silent --output - --user user:$(chainctl auth token --audience apk.cgr.dev) https://apk.cgr.dev/chainguard-private/$arch/APKINDEX.tar.gz | \
	zcat | \
	grep -a -A1 "^P:linux" | \
	grep "^V:" | \
	sort -V | \
	tail -n1 | sed -e "s/^V://")
kernel="boot/vmlinuz-$arch-$ver"

# Fetch the linux apk package, extract a vmlinuz kernel from a package and write it to the local directory
curl -L --silent --user user:$(chainctl auth token --audience apk.cgr.dev) https://apk.cgr.dev/chainguard-private/"$arch"/linux-"$ver".apk | \
	tar -xzO "$kernel" > "$dir"/"$(basename $kernel)" 2>/dev/null
echo "$(basename $kernel)"
