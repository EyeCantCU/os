[opts.ovmf.common]
NETWORK_HTTP_BOOT_ENABLE = TRUE
NETWORK_IP6_ENABLE       = TRUE
NETWORK_TLS_ENABLE       = TRUE
NETWORK_ISCSI_ENABLE     = TRUE
NETWORK_ALLOW_HTTP_CONNECTIONS = TRUE
TPM2_ENABLE              = TRUE
TPM2_CONFIG_ENABLE       = TRUE
TPM1_ENABLE              = FALSE
CAVIUM_ERRATUM_27456     = TRUE
SECURE_BOOT_ENABLE       = TRUE
BUILD_SHELL              = FALSE

[opts.ovmf.4m]
FD_SIZE_4MB              = TRUE
DEBUG_TO_MEM             = TRUE
SMM_REQUIRE              = TRUE

[opts.armvirt.silent]
DEBUG_PRINT_ERROR_LEVEL  = 0x80000000

[pcds.la57]
PcdUse5LevelPageTable    = TRUE

[pcds.nx.strict]
PcdDxeNxMemoryProtectionPolicy      = 0xC000000000007FD5
PcdImageProtectionPolicy            = 0x03
PcdSetNxForStack                    = TRUE
PcdNullPointerDetectionPropertyMask = 0x03
PcdUninstallMemAttrProtocol         = FALSE

[build.ovmf.4m]
desc = ovmf build (64-bit, 4MB, q35 only, smm, secure boot)
conf = OvmfPkg/OvmfPkgX64.dsc
arch = X64
opts = ovmf.common
       ovmf.4m
pcds = nx.strict
       la57
plat = OvmfX64
dest = Chainguard/x86_64
cpy1 = FV/OVMF_CODE.fd
cpy2 = FV/OVMF_VARS.fd

[build.armvirt]
desc = ArmVirt build for qemu, 64-bit (arm v8), secure boot
conf = ArmVirtPkg/ArmVirtQemu.dsc
arch = AARCH64
opts = ovmf.common
       armvirt.silent
pcds = nx.strict
plat = ArmVirtQemu-AARCH64
dest = Chainguard/aarch64
cpy1 = FV/QEMU_EFI.fd
cpy2 = FV/QEMU_VARS.fd
pad1 = QEMU_EFI.fd  64m
pad2 = QEMU_VARS.fd 64m
