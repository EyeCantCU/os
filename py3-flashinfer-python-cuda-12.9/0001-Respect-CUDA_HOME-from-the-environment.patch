From cbb6adb2cec121dccf968cf73440cd0ee96e8c60 Mon Sep 17 00:00:00 2001
From: dann frazier <dann.frazier@chainguard.dev>
Date: Mon, 14 Jul 2025 22:49:25 +0000
Subject: [PATCH] Respect CUDA_HOME from the environment

Signed-off-by: dann frazier <dann.frazier@chainguard.dev>
---
 setup.py | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/setup.py b/setup.py
index 7ca5026..3b094dd 100644
--- a/setup.py
+++ b/setup.py
@@ -79,10 +79,16 @@ if enable_aot:
     cmdclass["bdist_wheel"] = impure_bdist_wheel
 
     def get_cuda_version() -> Version:
-        if torch_cpp_ext.CUDA_HOME is None:
+        cuda_home = None
+        if 'CUDA_HOME' in os.environ:
+            cuda_home = os.environ['CUDA_HOME']
+        elif torch_cpp_ext.CUDA_HOME is None:
+            cuda_home = torch_cpp_ext.CUDA_HOME
+        if cuda_home is None:
             nvcc = "nvcc"
-        else:
-            nvcc = os.path.join(torch_cpp_ext.CUDA_HOME, "bin/nvcc")
+        else:
+            nvcc = os.path.join(cuda_home, "bin/nvcc")
+
         txt = subprocess.check_output([nvcc, "--version"], text=True)
         return Version(re.findall(r"release (\d+\.\d+),", txt)[0])
 
-- 
