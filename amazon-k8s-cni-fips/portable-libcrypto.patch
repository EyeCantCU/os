From fe6981fed5aefbecbbfa9cb91cfe7aceed5be4c0 Mon Sep 17 00:00:00 2001
From: Dimitri John Ledkov <dimitri.ledkov@surgut.co.uk>
Date: Wed, 19 Nov 2025 07:31:27 -0500
Subject: [PATCH] cmd: add support for portable libcrypto

---
 cmd/aws-vpc-cni-init/main.go | 20 ++++++++++++++++++++
 cmd/aws-vpc-cni/main.go      | 20 ++++++++++++++++++++
 2 files changed, 40 insertions(+)

diff --git a/cmd/aws-vpc-cni-init/main.go b/cmd/aws-vpc-cni-init/main.go
index 245ae382..ccc907a8 100644
--- a/cmd/aws-vpc-cni-init/main.go
+++ b/cmd/aws-vpc-cni-init/main.go
@@ -16,6 +16,7 @@ package main
 
 import (
 	"os"
+	"path/filepath"
 
 	"github.com/aws/amazon-vpc-cni-k8s/pkg/netlinkwrapper"
 	"github.com/aws/amazon-vpc-cni-k8s/pkg/procsyswrapper"
@@ -160,6 +161,25 @@ func _main() int {
 	}
 	log.Infof("Copied all CNI plugin binaries to %s", hostCNIBinPath)
 
+	// Setup portable libcrypto
+	cgrDir := filepath.Join(hostCNIBinPath, ".cgr")
+	err = os.MkdirAll(cgrDir, 0o755)
+	if err != nil {
+		log.WithError(err).Errorf("Failed to create .cgr dir")
+		return 1
+	}
+	cgr_files := []string{
+		"/etc/ssl/fipsmodule.cnf",
+		"/etc/ssl/openssl.cnf",
+		"/usr/lib/libcrypto3/libcrypto.so.3",
+		"/usr/lib/ossl-modules/fips.so",
+	}
+	err = cp.InstallBinaries(cgr_files, cgrDir)
+	if err != nil {
+		log.WithError(err).Errorf("Failed to copy .cgr files")
+		return 1
+	}
+
 	var primaryIF string
 	primaryIF, err = getNodePrimaryIF()
 	if err != nil {
diff --git a/cmd/aws-vpc-cni/main.go b/cmd/aws-vpc-cni/main.go
index d0627c6e..4b08fc8f 100644
--- a/cmd/aws-vpc-cni/main.go
+++ b/cmd/aws-vpc-cni/main.go
@@ -40,6 +40,7 @@ import (
 	"net"
 	"os"
 	"os/exec"
+	"path/filepath"
 	"strconv"
 	"strings"
 
@@ -429,6 +430,25 @@ func _main() int {
 		return 1
 	}
 
+	// Setup portable libcrypto
+	cgrDir := filepath.Join(hostCNIBinPath, ".cgr")
+	err = os.MkdirAll(cgrDir, 0o755)
+	if err != nil {
+		log.WithError(err).Errorf("Failed to create .cgr dir")
+		return 1
+	}
+	cgr_files := []string{
+		"/etc/ssl/fipsmodule.cnf",
+		"/etc/ssl/openssl.cnf",
+		"/usr/lib/libcrypto3/libcrypto.so.3",
+		"/usr/lib/ossl-modules/fips.so",
+	}
+	err = cp.InstallBinaries(cgr_files, cgrDir)
+	if err != nil {
+		log.WithError(err).Errorf("Failed to copy .cgr files")
+		return 1
+	}
+
 	log.Infof("Starting IPAM daemon... ")
 
 	cmd := "./aws-k8s-agent"
-- 
2.51.0

