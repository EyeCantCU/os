From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: uti.edun <uti.edun@chainguard.dev>
Date: Sat, 4 Oct 2025 15:55:00 +0100
Subject: [PATCH] pybind/rbd: use libcpp.bool for librbd boolean arguments

Recent librbd headers switched to `bool*` parameters for several helper
functions. Our Cython bindings still declared those signatures as using
`bint`, which Cython maps to an `int`. That mismatch leads to generated code
that passes `int*` to librbd, tripping `-Wincompatible-pointer-types` in the
Wolfi build of Ceph 18. A previous attempt to typedef `bool` from C collided
with `<stdbool.h>`, producing `typedef int bool;` errors.

Import `libcpp` and rely on `libcpp.bool` everywhere we hand boolean buffers
into librbd. The real and mock bindings now declare the updated signatures, and
the Python wrapper allocates `libcpp.bool` locals before calling into C. With
these changes Cython emits `_Bool` consistently and the package build proceeds
past the rbd extension.

---
 src/pybind/rbd/c_rbd.pxd    | 6 +++---
 src/pybind/rbd/mock_rbd.pxi | 6 +++---
 src/pybind/rbd/rbd.pyx      | 4 ++--
 3 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/src/pybind/rbd/c_rbd.pxd b/src/pybind/rbd/c_rbd.pxd
index 9624cb4ce05..4bce3846eea 100644
--- a/src/pybind/rbd/c_rbd.pxd
+++ b/src/pybind/rbd/c_rbd.pxd
@@ -2,6 +2,7 @@
 
 from libc.stdint cimport *
 from ctime cimport time_t, timespec
+cimport libcpp
 
 cdef extern from "rados/librados.h":
     enum:
@@ -530,7 +531,7 @@ cdef extern from "rbd/librbd.h" nogil:
     int rbd_snap_unprotect(rbd_image_t image, const char *snap_name)
     int rbd_snap_is_protected(rbd_image_t image, const char *snap_name,
                               int *is_protected)
-    int rbd_snap_exists(rbd_image_t image, const char *snapname, bint *exists)
+    int rbd_snap_exists(rbd_image_t image, const char *snapname, libcpp.bool *exists)
     int rbd_snap_get_limit(rbd_image_t image, uint64_t *limit)
     int rbd_snap_set_limit(rbd_image_t image, uint64_t limit)
     int rbd_snap_get_timestamp(rbd_image_t image, uint64_t snap_id, timespec *timestamp)
@@ -721,9 +722,9 @@ cdef extern from "rbd/librbd.h" nogil:
     int rbd_namespace_list(rados_ioctx_t io, char *namespace_names,
                            size_t *size)
     int rbd_namespace_exists(rados_ioctx_t io, const char *namespace_name,
-                             bint *exists)
+                             libcpp.bool *exists)
 
-    int rbd_pool_init(rados_ioctx_t, bint force)
+    int rbd_pool_init(rados_ioctx_t, libcpp.bool force)
 
     void rbd_pool_stats_create(rbd_pool_stats_t *stats)
     void rbd_pool_stats_destroy(rbd_pool_stats_t stats)
diff --git a/src/pybind/rbd/mock_rbd.pxi b/src/pybind/rbd/mock_rbd.pxi
index 04a056fcc64..dd9596bd310 100644
--- a/src/pybind/rbd/mock_rbd.pxi
+++ b/src/pybind/rbd/mock_rbd.pxi
@@ -2,6 +2,7 @@
 
 from libc.stdint cimport *
 from ctime cimport time_t, timespec
+cimport libcpp
 
 cdef nogil:
     enum:
@@ -642,7 +643,7 @@ cdef nogil:
     int rbd_snap_is_protected(rbd_image_t image, const char *snap_name,
                               int *is_protected):
         pass
-    int rbd_snap_exists(rbd_image_t image, const char *snapname, bint *exists):
+    int rbd_snap_exists(rbd_image_t image, const char *snapname, libcpp.bool *exists):
         pass
     int rbd_snap_get_limit(rbd_image_t image, uint64_t *limit):
         pass
@@ -907,9 +908,9 @@ cdef nogil:
                            size_t *size):
         pass
     int rbd_namespace_exists(rados_ioctx_t io, const char *namespace_name,
-                             bint *exists):
+                             libcpp.bool *exists):
         pass
-    int rbd_pool_init(rados_ioctx_t io, bint force):
+    int rbd_pool_init(rados_ioctx_t io, libcpp.bool force):
         pass
     void rbd_pool_stats_create(rbd_pool_stats_t *stats):
         pass
diff --git a/src/pybind/rbd/rbd.pyx b/src/pybind/rbd/rbd.pyx
index 10464821b63..e0378b03674 100644
--- a/src/pybind/rbd/rbd.pyx
+++ b/src/pybind/rbd/rbd.pyx
@@ -23,6 +23,7 @@ from libc cimport errno
 from libc.stdint cimport *
 from libc.stdlib cimport malloc, realloc, free
 from libc.string cimport strdup, memset
+cimport libcpp
 
 try:
     from collections.abc import Iterable
@@ -1952,7 +1953,7 @@ class RBD(object):
         cdef:
             rados_ioctx_t _ioctx = convert_ioctx(ioctx)
             const char *_name = name
-            bint _exists = False
+            libcpp.bool _exists = False
         with nogil:
             ret = rbd_namespace_exists(_ioctx, _name, &_exists)
         if ret != 0:
@@ -1995,7 +1996,7 @@ class RBD(object):
         """
         cdef:
             rados_ioctx_t _ioctx = convert_ioctx(ioctx)
-            bint _force = force
+            libcpp.bool _force = force
         with nogil:
             ret = rbd_pool_init(_ioctx, _force)
         if ret != 0:
@@ -3707,7 +3708,7 @@ cdef class Image(object):
         name = cstr(name, 'name')
         cdef:
             char *_name = name
-            bint _exists = False
+            libcpp.bool _exists = False
         with nogil:
             ret = rbd_snap_exists(self.image, _name, &_exists)
         if ret != 0:
---
2.39.5
