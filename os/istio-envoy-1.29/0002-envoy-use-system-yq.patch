Use system yq binary instead of Bazel-downloaded yq to avoid architecture-specific
download failures where the aspect_bazel_lib yq toolchain binary is missing or
not executable on amd64.
---
 bazel/repo.bzl | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/bazel/repo.bzl b/bazel/repo.bzl
--- a/bazel/repo.bzl
+++ b/bazel/repo.bzl
@@ -68,7 +68,7 @@ def _envoy_repo_impl(repository_ctx):
     # parse container information for use in RBE
     json_result = repository_ctx.execute([
-        repository_ctx.path(repository_ctx.attr.yq),
+        "yq",
         repository_ctx.path(repository_ctx.attr.envoy_ci_config),
         "-ojson",
     ])
