 };
 
@@ -467,6 +484,9 @@ static int hkdf_test(const char *shash, const struct hkdf_testvec *tv)
 	unsigned int prk_size;
 	const char *driver;
 	int err;
+	if (fips_enabled && tv->fips_skip) {
+		return 0;
+	}
 
 	tfm = crypto_alloc_shash(shash, 0, 0);
 	if (IS_ERR(tfm)) {
