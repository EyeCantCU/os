 		.test = "unsalted hkdf test with zero info",
 		.ikm  = "\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c"
@@ -458,6 +474,7 @@ static const struct hkdf_testvec hkdf_sha512_tv[] = {
