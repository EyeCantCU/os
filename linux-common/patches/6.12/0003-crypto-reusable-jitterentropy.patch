+++ b/crypto/jitterentropy-optimized.c
@@ -83,6 +83,7 @@ int jent_hash_time(void *hash_state, __u64 time, u8 *addtl,
 		if (ret)
 			goto err;
 	}
+	jent_shim_kmsan_unpoison_memory(intermediary, sizeof(intermediary));
 
 	/*
 	 * Inject the data from the previous loop into the pool. This data is
diff --git a/crypto/jitterentropy-shim.c b/crypto/jitterentropy-shim.c
index 810528a6a39a3..98091838740b9 100644
--- a/crypto/jitterentropy-shim.c
+++ b/crypto/jitterentropy-shim.c
@@ -236,6 +236,11 @@ void jent_shim_put_unaligned_le32(u32 val, void *p)
 	put_unaligned_le32(val, p);
 }
 
+u64 jent_shim_le64_to_cpu(__le64 p)
+{
+	return le64_to_cpu(p);
+}
+
 /* Crypto registration */
 int jent_shim_crypto_register_rng(void *alg)
 {
@@ -319,3 +324,7 @@ void *jent_shim_crypto_rng_ctx(void *tfm)
 	return crypto_rng_ctx((struct crypto_rng *)tfm);
 }
 
+void jent_shim_kmsan_unpoison_memory(const void *address, size_t size)
+{
+	kmsan_unpoison_memory(address, size);
+}
diff --git a/crypto/jitterentropy-shim.h b/crypto/jitterentropy-shim.h
index 2a0b04abcf0e0..409c281953cd7 100644
--- a/crypto/jitterentropy-shim.h
+++ b/crypto/jitterentropy-shim.h
@@ -70,6 +70,7 @@ u64 jent_shim_get_unaligned_le64(const void *p);
 void jent_shim_put_unaligned_le64(u64 val, void *p);
 u32 jent_shim_get_unaligned_le32(const void *p);
 void jent_shim_put_unaligned_le32(u32 val, void *p);
+u64 jent_shim_le64_to_cpu(__le64 p);
 
 /* Crypto registration */
 int jent_shim_crypto_register_rng(void *alg);
@@ -101,4 +102,6 @@ int jent_shim_module_param(void);
 void *jent_shim_crypto_tfm_ctx(void *tfm);
