+++ b/crypto/jitterentropy-shim.c
@@ -0,0 +1,361 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Jitter RNG shim layer implementation
+ *
+ * This file provides wrapper functions for Linux kernel functions
+ * used by the jitterentropy modules, creating an abstraction layer.
+ */
+
+#include <crypto/hash.h>
+#include <crypto/internal/rng.h>
+#include <linux/atomic.h>
+#include <linux/bitops.h>
+#include <linux/debugfs.h>
+#include <linux/fips.h>
+#include <linux/kernel.h>
+#include <linux/minmax.h>
+#include <linux/module.h>
+#include <linux/sched.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/time.h>
+#include <linux/types.h>
+#include <linux/uaccess.h>
+#include <linux/unaligned.h>
+#include <linux/wait.h>
+#include <linux/printk.h>
+
+#include "jitterentropy-shim.h"
+
+/* Memory allocation functions */
+void *jent_shim_kvzalloc(unsigned int len, gfp_t flags)
+{
+	return kvzalloc(len, flags);
+}
+
+void jent_shim_kvfree_sensitive(void *ptr, unsigned int len)
+{
+	kvfree_sensitive(ptr, len);
+}
+
+void *jent_shim_kzalloc(unsigned int len, gfp_t flags)
+{
+	return kzalloc(len, flags);
+}
+
+void jent_shim_kfree_sensitive(void *ptr)
+{
+	kfree_sensitive(ptr);
+}
+
+void *jent_shim_kmalloc(unsigned int size, gfp_t flags)
+{
+	return kmalloc(size, flags);
+}
+
+void jent_shim_kfree(void *ptr)
+{
+	kfree(ptr);
+}
+
+void jent_shim_kvzfree(void *ptr, unsigned int len)
+{
+	kvfree_sensitive(ptr, len);
+}
+
+void *jent_shim_zalloc(unsigned int len)
+{
+	return kzalloc(len, GFP_KERNEL);
+}
+
+void jent_shim_zfree(void *ptr)
+{
+	kfree_sensitive(ptr);
+}
+
+/* Time functions */
+unsigned long jent_shim_random_get_entropy(void)
+{
+	return random_get_entropy();
+}
+
+u64 jent_shim_ktime_get_ns(void)
+{
+	return ktime_get_ns();
+}
+
+/* Memory operations */
+void *jent_shim_memcpy(void *dest, const void *src, unsigned int n)
+{
+	return memcpy(dest, src, n);
+}
+
+void *jent_shim_memset(void *s, int c, unsigned int n)
+{
+	return memset(s, c, n);
+}
+
+void jent_shim_memzero_explicit(void *s, unsigned int count)
+{
+	memzero_explicit(s, count);
+}
+
+/* Printing functions */
+void jent_shim_pr_warn_ratelimited(const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	pr_warn_ratelimited("%pV", &(struct va_format){ fmt, &args });
+	va_end(args);
+}
+
+void jent_shim_pr_warn_once(const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	pr_warn_once("%pV", &(struct va_format){ fmt, &args });
+	va_end(args);
+}
+
+void jent_shim_pr_warn(const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	pr_warn("%pV", &(struct va_format){ fmt, &args });
+	va_end(args);
+}
+
+void jent_shim_pr_err(const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	pr_err("%pV", &(struct va_format){ fmt, &args });
+	va_end(args);
+}
+
+void jent_shim_pr_info(const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	pr_info("%pV", &(struct va_format){ fmt, &args });
+	va_end(args);
+}
+
+void jent_shim_printk(const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	printk("%pV", &(struct va_format){ fmt, &args });
+	va_end(args);
+}
+
+/* FIPS and system functions */
+
+int jent_shim_fips_enabled()
+{
+	return fips_enabled;
+}
+
+void jent_shim_panic(const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	panic(fmt, args);
+	va_end(args);
+}
+
+/* Utility functions */
+__u64 jent_shim_rol64(__u64 word, unsigned int shift)
+{
+	return rol64(word, shift);
+}
+
+/* Scheduler functions */
+int jent_shim_need_resched(void)
+{
+	return need_resched();
+}
+
+void jent_shim_schedule(void)
+{
+	schedule();
+}
+
+int jent_shim_signal_pending(void *current_task)
+{
+	return signal_pending(current);
+}
+
+/* Wait queue functions */
+void jent_shim_wake_up_interruptible(void *wait_queue)
+{
+	wake_up_interruptible((wait_queue_head_t *)wait_queue);
+}
+
+int jent_shim_wq_has_sleeper(void *wait_queue)
+{
+	return wq_has_sleeper((wait_queue_head_t *)wait_queue);
+}
+
+int jent_shim_wait_event_interruptible(void *wait_queue, int condition)
+{
+	return wait_event_interruptible(*(wait_queue_head_t *)wait_queue, condition);
+}
+
+/* User space access */
+unsigned long jent_shim_copy_to_user(void __user *to, const void *from, unsigned long n)
+{
+	return copy_to_user(to, from, n);
+}
+
+/* Alignment */
+void *jent_shim_PTR_ALIGN(const void *p, unsigned int a)
+{
+	return (void *)PTR_ALIGN(p, a);
+}
+
+/* Unaligned access */
+u64 jent_shim_get_unaligned_le64(const void *p)
+{
+	return get_unaligned_le64(p);
+}
+
+void jent_shim_put_unaligned_le64(u64 val, void *p)
+{
+	put_unaligned_le64(val, p);
+}
+
+u32 jent_shim_get_unaligned_le32(const void *p)
+{
+	return get_unaligned_le32(p);
+}
+
+void jent_shim_put_unaligned_le32(u32 val, void *p)
+{
+	put_unaligned_le32(val, p);
+}
+
+u64 jent_shim_le64_to_cpu(__le64 p)
+{
+	return le64_to_cpu(p);
+}
+
+/* Crypto registration */
+int jent_shim_crypto_register_rng(void *alg)
+{
+	return crypto_register_rng((struct rng_alg *)alg);
+}
+
+void jent_shim_crypto_unregister_rng(void *alg)
+{
+	crypto_unregister_rng((struct rng_alg *)alg);
+}
+
+/* Module and debugfs functions */
+struct dentry *jent_shim_debugfs_create_dir(const char *name, struct dentry *parent)
+{
+	return debugfs_create_dir(name, parent);
+}
+
+struct dentry *jent_shim_debugfs_create_file_unsafe(const char *name, umode_t mode,
+						   struct dentry *parent, void *data,
+						   const void *fops)
+{
+	return debugfs_create_file_unsafe(name, mode, parent, data, 
+					  (const struct file_operations *)fops);
+}
+
+void jent_shim_debugfs_remove_recursive(struct dentry *dentry)
+{
+	debugfs_remove_recursive(dentry);
+}
+
+/* Spinlock functions */
+void jent_shim_spin_lock_init(void *lock)
+{
+	spin_lock_init((spinlock_t *)lock);
+}
+
+void jent_shim_spin_lock(void *lock)
+{
+	spin_lock((spinlock_t *)lock);
+}
+
+void jent_shim_spin_unlock(void *lock)
+{
+	spin_unlock((spinlock_t *)lock);
+}
+
+void jent_shim_spin_lock_irqsave(void *lock, unsigned long *flags)
+{
+	spin_lock_irqsave((spinlock_t *)lock, *flags);
+}
+
+void jent_shim_spin_unlock_irqrestore(void *lock, unsigned long flags)
+{
+	spin_unlock_irqrestore((spinlock_t *)lock, flags);
+}
+
+/* Atomic operations */
+void jent_shim_atomic_set(void *atomic, int val)
+{
+	atomic_set((atomic_t *)atomic, val);
+}
+
+int jent_shim_atomic_read(const void *atomic)
+{
+	return atomic_read((const atomic_t *)atomic);
+}
+
+void jent_shim_atomic_inc(void *atomic)
+{
+	atomic_inc((atomic_t *)atomic);
+}
+
+/* Crypto context functions */
+void *jent_shim_crypto_tfm_ctx(void *tfm)
+{
+	return crypto_tfm_ctx((struct crypto_tfm *)tfm);
+}
+
+void *jent_shim_crypto_rng_ctx(void *tfm)
+{
+	return crypto_rng_ctx((struct crypto_rng *)tfm);
+}
+
+void jent_shim_kmsan_unpoison_memory(const void *address, size_t size)
+{
+	kmsan_unpoison_memory(address, size);
+}
+
+/* Crypto shash functions */
+void jent_shim_shash_desc_zero(void *desc)
+{
+	shash_desc_zero((struct shash_desc *)desc);
+}
+
+int jent_shim_crypto_shash_init(void *desc)
+{
+	return crypto_shash_init((struct shash_desc *)desc);
+}
+
+int jent_shim_crypto_shash_update(void *desc, const void *data, unsigned int len)
+{
+	return crypto_shash_update((struct shash_desc *)desc, (const u8 *)data, len);
+}
+
+int jent_shim_crypto_shash_finup(void *desc, const void *data, unsigned int len, void *out)
+{
+	return crypto_shash_finup((struct shash_desc *)desc, (const u8 *)data, len, (u8 *)out);
+}
+
+int jent_shim_crypto_shash_final(void *desc, void *out)
+{
+	return crypto_shash_final((struct shash_desc *)desc, (u8 *)out);
+}
+
+unsigned int jent_shim_crypto_shash_digestsize(void *tfm)
+{
+	return crypto_shash_digestsize((struct crypto_shash *)tfm);
+}
