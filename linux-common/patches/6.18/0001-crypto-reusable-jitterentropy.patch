+++ b/crypto/jitterentropy-optimized.c
@@ -0,0 +1,137 @@
+/*
+ * Non-physical true random number generator based on timing jitter --
+ * Linux Kernel Crypto API specific code
+ *
+ * Copyright Stephan Mueller <smueller@chronox.de>, 2015 - 2023
