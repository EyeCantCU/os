--- /dev/null
+++ b/crypto/sha3_jitter.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Internal functions for sha3 jitterentropy
+ */
+#ifndef __CRYPTO_SHA3_JITTER_INTERNAL_H__
+#define __CRYPTO_SHA3_JITTER_INTERNAL_H__
+
+void keccakf_round(u64 st[25]);
+void keccakf(u64 st[25]);
+int crypto_sha3_init(struct shash_desc *desc);
+int crypto_sha3_update(struct shash_desc *desc, const u8 *data,
+			      unsigned int len);
+int crypto_sha3_finup(struct shash_desc *desc, const u8 *src,
+			     unsigned int len, u8 *out);
+
+#endif
diff --git a/include/crypto/sha3_jitter.h b/include/crypto/sha3_jitter.h
new file mode 100644
index 0000000000000..c4d37731af5dc
--- /dev/null
+++ b/include/crypto/sha3_jitter.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Common values for SHA-3 algorithms
+ */
+#ifndef __CRYPTO_SHA3_JITTER_H__
+#define __CRYPTO_SHA3_JITTER_H__
+
+#include <linux/types.h>
+
+#define SHA3_224_DIGEST_SIZE	(224 / 8)
+#define SHA3_224_BLOCK_SIZE	(200 - 2 * SHA3_224_DIGEST_SIZE)
+#define SHA3_224_EXPORT_SIZE	SHA3_STATE_SIZE + SHA3_224_BLOCK_SIZE + 1
+
+#define SHA3_256_DIGEST_SIZE	(256 / 8)
+#define SHA3_256_BLOCK_SIZE	(200 - 2 * SHA3_256_DIGEST_SIZE)
+#define SHA3_256_EXPORT_SIZE	SHA3_STATE_SIZE + SHA3_256_BLOCK_SIZE + 1
+
+#define SHA3_384_DIGEST_SIZE	(384 / 8)
+#define SHA3_384_BLOCK_SIZE	(200 - 2 * SHA3_384_DIGEST_SIZE)
+#define SHA3_384_EXPORT_SIZE	SHA3_STATE_SIZE + SHA3_384_BLOCK_SIZE + 1
+
+#define SHA3_512_DIGEST_SIZE	(512 / 8)
+#define SHA3_512_BLOCK_SIZE	(200 - 2 * SHA3_512_DIGEST_SIZE)
+#define SHA3_512_EXPORT_SIZE	SHA3_STATE_SIZE + SHA3_512_BLOCK_SIZE + 1
+
+#define SHA3_STATE_SIZE		200
+
+struct shash_desc;
+
+struct sha3_state {
+	u64		st[SHA3_STATE_SIZE / 8];
+};
+
+int crypto_sha3_jitter_init(struct shash_desc *desc);
+
+int sha3_jitter_mod_init(void);
+void sha3_jitter_mod_exit(void);
+#endif
