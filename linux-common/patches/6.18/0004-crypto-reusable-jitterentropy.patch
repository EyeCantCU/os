From d43405f994e3532b9585d851215fe4e11912766d Mon Sep 17 00:00:00 2001
From: Amelia Crate <amelia.crate@chainguard.dev>
Date: Tue, 29 Jul 2025 12:06:47 -0700
Subject: [PATCH 4/4] crypto: reusable jitterentropy

modify crypto/Makefile for highly reusable jitterentropy

* include vendored sha3-jitterentropy in jitterentropy_rng module
* include module and shim objects in jitterentropy_rng module
* use prebuilt jitterentropy and sha3 objects unless REBUILD_JITTERENTROPY is set
* disable UBSAN, KASAN, KCOV_INSTRUMENT for objects which should be prebuilt

Guarding the CFLAGS stuff not necessary, but is nice because jitterentropy emits #error if
compiled with optimizations, so this is a small guardrail against unintentional
rebuilding of jitterentropy.
---
 crypto/Makefile | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/crypto/Makefile b/crypto/Makefile
index e430e6e99b6a2..5a3454b95eaff 100644
--- a/crypto/Makefile
+++ b/crypto/Makefile
@@ -3,6 +3,15 @@
 # Cryptographic API
 #
 
+jent_sources = jitterentropy jitterentropy-optimized sha3-jitterentropy
+# Use 'make REBUILD_JITTERENTROPY=1' to ignore prebuilt objects
+ifdef REBUILD_JITTERENTROPY
+$(foreach jent_src,$(jent_sources),$(eval $(obj)/$(jent_src).o: $(src)/$(jent_src).c))
+else
+$(foreach jent_src,$(jent_sources),$(obj)/$(jent_src).o): $(subst $(obj),$(src),$(@))
+	$(call if-changed,copy)
+endif
+
 obj-$(CONFIG_CRYPTO) += crypto.o
 crypto-y := api.o cipher.o
 
@@ -166,10 +175,20 @@ obj-$(CONFIG_CRYPTO_RNG2) += rng.o
 obj-$(CONFIG_CRYPTO_ANSI_CPRNG) += ansi_cprng.o
 obj-$(CONFIG_CRYPTO_DRBG) += drbg.o
 obj-$(CONFIG_CRYPTO_JITTERENTROPY) += jitterentropy_rng.o
+ifdef REBUILD_JITTERENTROPY
 CFLAGS_jitterentropy.o = -O0
+# Disable for certified objects
 KASAN_SANITIZE_jitterentropy.o = n
 UBSAN_SANITIZE_jitterentropy.o = n
-jitterentropy_rng-y := jitterentropy.o jitterentropy-kcapi.o
+KCOV_INSTRUMENT_jitterentropy.o = n
+KASAN_SANITIZE_jitterentropy-optimized.o = n
+UBSAN_SANITIZE_jitterentropy-optimized.o = n
+KCOV_INSTRUMENT_jitterentropy-optimized.o = n
+KASAN_SANITIZE_sha3-jitterentropy.o = n
+UBSAN_SANITIZE_sha3-jitterentropy.o = n
+KCOV_INSTRUMENT_sha3-jitterentropy.o = n
+endif
+jitterentropy_rng-y := jitterentropy.o jitterentropy-optimized.o jitterentropy-kcapi.o jitterentropy-shim.o sha3-jitterentropy.o sha3-jitterentropy-kcapi.o
 obj-$(CONFIG_CRYPTO_JITTERENTROPY_TESTINTERFACE) += jitterentropy-testing.o
 obj-$(CONFIG_CRYPTO_BENCHMARK) += tcrypt.o
 obj-$(CONFIG_CRYPTO_GHASH) += ghash-generic.o
