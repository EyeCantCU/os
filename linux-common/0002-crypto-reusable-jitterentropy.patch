diff --git a/crypto/jitterentropy-shim.c b/crypto/jitterentropy-shim.c
new file mode 100644
index 000000000000..ac074593c4f2
--- /dev/null
+++ b/crypto/jitterentropy-shim.c
@@ -0,0 +1,306 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Jitter RNG shim layer implementation
+ *
+ * This file provides wrapper functions for Linux kernel functions
+ * used by the jitterentropy modules, creating an abstraction layer.
+ */
+
+#include <crypto/hash.h>
+#include <crypto/internal/rng.h>
+#include <linux/atomic.h>
+#include <linux/bitops.h>
+#include <linux/debugfs.h>
+#include <linux/fips.h>
+#include <linux/kernel.h>
+#include <linux/minmax.h>
+#include <linux/module.h>
+#include <linux/sched.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>  
+#include <linux/time.h>
+#include <linux/types.h>
+#include <linux/uaccess.h>
+#include <linux/unaligned.h>
+#include <linux/wait.h>
+#include <linux/printk.h>
+
+#include "jitterentropy-shim.h"
+
+/* Memory allocation functions */
+void *jent_shim_kvzalloc(unsigned int len, gfp_t flags)
+{
+	return kvzalloc(len, flags);
+}
+
+void jent_shim_kvfree_sensitive(void *ptr, unsigned int len)
+{
+	kvfree_sensitive(ptr, len);
+}
+
+void *jent_shim_kzalloc(unsigned int len, gfp_t flags)
+{
+	return kzalloc(len, flags);
+}
+
+void jent_shim_kfree_sensitive(void *ptr)
+{
+	kfree_sensitive(ptr);
+}
+
+void *jent_shim_kmalloc(unsigned int size, gfp_t flags)
+{
+	return kmalloc(size, flags);
+}
+
+void jent_shim_kfree(void *ptr)
+{
+	kfree(ptr);
+}
+
+/* Time functions */
+unsigned long jent_shim_random_get_entropy(void)
+{
+	return random_get_entropy();
+}
+
+u64 jent_shim_ktime_get_ns(void)
+{
+	return ktime_get_ns();
+}
+
+/* Memory operations */
+void *jent_shim_memcpy(void *dest, const void *src, unsigned int n)
+{
+	return memcpy(dest, src, n);
+}
+
+void *jent_shim_memset(void *s, int c, unsigned int n)
+{
+	return memset(s, c, n);
+}
+
+void jent_shim_memzero_explicit(void *s, unsigned int count)
+{
+	memzero_explicit(s, count);
+}
+
+/* Printing functions */
+void jent_shim_pr_warn_ratelimited(const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	pr_warn_ratelimited("%pV", &(struct va_format){ fmt, &args });
+	va_end(args);
+}
+
+void jent_shim_pr_warn_once(const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	pr_warn_once("%pV", &(struct va_format){ fmt, &args });
+	va_end(args);
+}
+
+void jent_shim_pr_warn(const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	pr_warn("%pV", &(struct va_format){ fmt, &args });
+	va_end(args);
+}
+
+void jent_shim_pr_err(const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	pr_err("%pV", &(struct va_format){ fmt, &args });
+	va_end(args);
+}
+
+void jent_shim_pr_info(const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	pr_info("%pV", &(struct va_format){ fmt, &args });
+	va_end(args);
+}
+
+void jent_shim_printk(const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	printk("%pV", &(struct va_format){ fmt, &args });
+	va_end(args);
+}
+
+/* FIPS and system functions */
+
+int jent_shim_fips_enabled()
+{
+	return fips_enabled;
+}
+
+void jent_shim_panic(const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	panic(fmt, args);
+	va_end(args);
+}
+
+/* Utility functions */
+__u64 jent_shim_rol64(__u64 word, unsigned int shift)
+{
+	return rol64(word, shift);
+}
+
+/* Scheduler functions */
+int jent_shim_need_resched(void)
+{
+	return need_resched();
+}
+
+void jent_shim_schedule(void)
+{
+	schedule();
+}
+
+int jent_shim_signal_pending(void *current_task)
+{
+	return signal_pending(current);
+}
+
+/* Wait queue functions */
+void jent_shim_wake_up_interruptible(void *wait_queue)
+{
+	wake_up_interruptible((wait_queue_head_t *)wait_queue);
+}
+
+int jent_shim_wq_has_sleeper(void *wait_queue)
+{
+	return wq_has_sleeper((wait_queue_head_t *)wait_queue);
+}
+
+int jent_shim_wait_event_interruptible(void *wait_queue, int condition)
+{
+	return wait_event_interruptible(*(wait_queue_head_t *)wait_queue, condition);
+}
+
+/* User space access */
+unsigned long jent_shim_copy_to_user(void __user *to, const void *from, unsigned long n)
