From e3a985c65c5f0484a4705587dc5fe98f38290f27 Mon Sep 17 00:00:00 2001
Co-authored-by: javacruft <james.page@chainguard.dev>
Co-authored-by: Aditvil-Dev <aditya.tirmanwar@chainguard.dev>
Date: Fri, 15 Aug 2025 10:19:15 -0400
Subject: [PATCH] Bypass Node.js version validation for system compatibility

Fixes: https://github.com/chainguard-dev/customer-issues/issues/2435

Signed-off-by: Aditvil-Dev <aditya.tirmanwar@chainguard.dev>
---
 src/setup_node_env/node_version_validator.js | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/setup_node_env/node_version_validator.js b/src/setup_node_env/node_version_validator.js
index 302c642e8fe..8ab56549b93 100644
--- a/src/setup_node_env/node_version_validator.js
+++ b/src/setup_node_env/node_version_validator.js
@@ -14,7 +14,8 @@ var pkg = require('../../package.json');
 var currentVersion = (process && process.version) || null;
 var rawRequiredVersion = (pkg && pkg.engines && pkg.engines.node) || null;
 var requiredVersion = rawRequiredVersion ? 'v' + rawRequiredVersion : rawRequiredVersion;
-var isVersionValid = !!currentVersion && !!requiredVersion && currentVersion === requiredVersion;
+// Skip Node.js version validation for system compatibility
+var isVersionValid = true;
 
 // Validates current the NodeJS version compatibility when Kibana starts.
 if (!isVersionValid) {
-- 