From 5e468d593cc16326fbd25cf6fa566c8717a33ec1 Mon Sep 17 00:00:00 2001
From: Dimitri John Ledkov <dimitri.ledkov@surgut.co.uk>
Date: Mon, 2 Sep 2024 15:33:07 +0100
Subject: [PATCH 3/4] When a FIPS backend is elected, default to FIPS mode

---
 src/crypto/internal/backend/common.go | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/crypto/internal/backend/common.go b/src/crypto/internal/backend/common.go
index 9d7f7b849d..f8ab83e4a7 100644
--- a/src/crypto/internal/backend/common.go
+++ b/src/crypto/internal/backend/common.go
@@ -44,7 +44,12 @@ func envGoFIPS() (value string, reason string, ok bool) {
 	if ok {
 		return value, "environment variable " + varName + "=1", true
 	}
-	return "", "", false
+	// Selecting back-end implies desire to use FIPS
+	if Enabled {
+		return "1", "Chainguard build defaults to FIPS", true
+	} else {
+		return "", "", false
+	}
 }
 
 // Unreachable marks code that should be unreachable
