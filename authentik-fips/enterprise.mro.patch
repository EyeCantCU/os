Description: Fix ConditionalInheritance Method Resolution Order (MRO) errors in authentik version 2025.10.0
.
Comment out ConditionalInheritance calls from RadiusProviderSerializer and
SCIMProviderSerializer to prevent Method Resolution Order (MRO) errors
when the authentik.enterprise module is not present.

Author: Matthew Ramirez <matthew.ramirez@chainguard.dev>
Forwarded: not-needed

diff --git a/authentik/providers/radius/api/providers.py b/authentik/providers/radius/api/providers.py
index 0e5c1f9a2..c2e8b77e9 100644
--- a/authentik/providers/radius/api/providers.py
+++ b/authentik/providers/radius/api/providers.py
@@ -32,9 +32,9 @@ from authentik.providers.radius.models import RadiusProvider


 class RadiusProviderSerializer(
-    ConditionalInheritance(
-        "authentik.enterprise.providers.radius.api.RadiusProviderSerializerMixin"
-    ),
+    #ConditionalInheritance(
+    #    "authentik.enterprise.providers.radius.api.RadiusProviderSerializerMixin"
+    #),
     ProviderSerializer,
 ):
     """RadiusProvider Serializer"""
diff --git a/authentik/providers/scim/api/providers.py b/authentik/providers/scim/api/providers.py
index 2fcd35c2c..f8a77b6af 100644
--- a/authentik/providers/scim/api/providers.py
+++ b/authentik/providers/scim/api/providers.py
@@ -19,7 +19,7 @@ from authentik.providers.scim.tasks import scim_sync


 class SCIMProviderSerializer(
-    ConditionalInheritance("authentik.enterprise.providers.scim.api.SCIMProviderSerializerMixin"),
+    #ConditionalInheritance("authentik.enterprise.providers.scim.api.SCIMProviderSerializerMixin"),
     ProviderSerializer,
 ):
     """SCIMProvider Serializer"""
