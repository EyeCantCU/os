+++ libgcrypt-1.11.1/random/jitterentropy-gcd.h	1970-01-01 01:00:00.000000000 +0100
@@ -1,42 +0,0 @@
-/*
- * Copyright (C) 2021, Stephan Mueller <smueller@chronox.de>
- *
