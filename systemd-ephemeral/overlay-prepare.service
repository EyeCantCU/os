[Unit]
Description=Prepare overlay directories with correct SELinux contexts
DefaultDependencies=no
Before=var.mount home.mount etc.mount root.mount usr-local-share-ca-certificates.mount
After=systemd-remount-fs.service
ConditionKernelCommandLine=chainguard.immutable=volatile

[Service]
Type=oneshot
# -Z uses matchpathcon() which reads file_contexts for correct SELinux context
ExecStart=/usr/bin/mkdir -Z -p /run/overlays/var/upper /run/overlays/var/work
ExecStart=/usr/bin/mkdir -Z -p /run/overlays/home/upper /run/overlays/home/work
ExecStart=/usr/bin/mkdir -Z -p /run/overlays/etc/upper /run/overlays/etc/work
ExecStart=/usr/bin/mkdir -Z -p /run/overlays/root/upper /run/overlays/root/work
ExecStart=/usr/bin/mkdir -Z -p /run/overlays/usr/local/upper /run/overlays/usr/local/work
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
