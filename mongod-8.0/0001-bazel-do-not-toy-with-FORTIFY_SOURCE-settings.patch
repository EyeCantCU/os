-    "//bazel/config:gcc_opt": ["_FORTIFY_SOURCE=2"],
-    "//conditions:default": [],
-})
-
 DEBUG_DEFINES = select({
     "//bazel/config:dbg_enabled": [],
     "//conditions:default": ["NDEBUG"],
@@ -105,7 +97,6 @@ MONGO_GLOBAL_DEFINES = (
     UNDEFINED_SANITIZER_DEFINES +
     GLIBCXX_DEBUG_DEFINES +
