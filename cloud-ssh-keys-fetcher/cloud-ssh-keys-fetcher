#!/bin/sh

mkdir -p /root/.ssh/
chmod 0700 /root/.ssh/

touch /root/.ssh/authorized_keys
chmod 0600 /root/.ssh/authorized_keys

if curl --max-time 1 --silent --output /dev/null "http://metadata.google.internal"; then
	curl -H "Metadata-Flavor: Google" "http://metadata.google.internal/computeMetadata/v1/instance/attributes/ssh-keys" | cut -d':' -f2- > /root/.ssh/authorized_keys
elif [ "$(curl --max-time 1 --silent --output /dev/null --write-out "%{http_code}" -H "Metadata: true" "http://169.254.169.254/latest/meta-data/instance-id")" = "200" ]; then
	curl -s "http://169.254.169.254/latest/meta-data/public-keys/0/openssh-key" > /root/.ssh/authorized_keys
elif [ "$(curl --max-time 1 --silent --output /dev/null --write-out "%{http_code}" -H "Metadata: true" "http://169.254.169.254/metadata/instance?api-version=2021-02-01")" = "200" ]; then
	curl -H "Metadata: true" "http://169.254.169.254/metadata/instance/compute/publicKeys?api-version=2021-02-01" | cut -d':' -f2 | cut -d'"' -f2 > /root/.ssh/authorized_keys
else
	exit 1
fi
