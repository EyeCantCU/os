From 6e162aa5ca0480d52991744202f525d08d3e0b97 Mon Sep 17 00:00:00 2001
From: Michelle McAveety <michelle.mcaveety@chainguard.dev>
Date: Thu, 12 Jun 2025 16:40:53 -0400
Subject: [PATCH] patch: switch md5 -> sha256

Signed-off-by: Michelle McAveety <michelle.mcaveety@chainguard.dev>
---
 internal/js/modules/k6/crypto/crypto.go | 9 ++++-----
 lib/models.go                           | 7 ++++---
 2 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/internal/js/modules/k6/crypto/crypto.go b/internal/js/modules/k6/crypto/crypto.go
index 29ccd998c..76e3effdf 100644
--- a/internal/js/modules/k6/crypto/crypto.go
+++ b/internal/js/modules/k6/crypto/crypto.go
@@ -2,8 +2,7 @@
 package crypto
 
 import (
-	"crypto/hmac"
-	"crypto/md5" // #nosec G501 // MD5 is weak, but we need it for compatibility
+	"crypto/hmac" // #nosec G501 // MD5 is weak, but we need it for compatibility
 	"crypto/rand"
 	"crypto/sha1" // #nosec G505 // SHA1 is weak, but we need it for compatibility
 	"crypto/sha256"
@@ -59,7 +58,7 @@ func (c *Crypto) Exports() modules.Exports {
 			"createHMAC":  c.createHMAC,
 			"hmac":        c.hmac,
 			"md4":         c.md4,
-			"md5":         c.md5,
+			"md5":         c.sha256,
 			"randomBytes": c.randomBytes,
 			"ripemd160":   c.ripemd160,
 			"sha1":        c.sha1,
@@ -94,7 +93,7 @@ func (c *Crypto) md4(input interface{}, outputEncoding string) (interface{}, err
 
 // md5 returns the MD5 hash of input in the given encoding.
 func (c *Crypto) md5(input interface{}, outputEncoding string) (interface{}, error) {
-	return c.buildInputsDigest("md5", input, outputEncoding)
+	return c.buildInputsDigest("sha256", input, outputEncoding)
 }
 
 // sha1 returns the SHA1 hash of input in the given encoding.
@@ -196,7 +195,7 @@ func (c *Crypto) parseHashFunc(a string) func() hash.Hash {
 	case "md4":
 		h = md4.New
 	case "md5":
-		h = md5.New
+		h = sha256.New
 	case "sha1":
 		h = sha1.New
 	case "sha256":
diff --git a/lib/models.go b/lib/models.go
index fbf93273c..0003d6070 100644
--- a/lib/models.go
+++ b/lib/models.go
@@ -1,7 +1,8 @@
 package lib
 
 import (
-	"crypto/md5" //nolint:gosec
+	//nolint:gosec
+	"crypto/sha256"
 	"encoding/hex"
 	"encoding/json"
 	"errors"
@@ -127,7 +128,7 @@ func NewGroup(name string, parent *Group) (*Group, error) {
 		return nil, err
 	}
 
-	hash := md5.Sum([]byte(path)) //nolint:gosec
+	hash := sha256.Sum256([]byte(path)) //nolint:gosec
 	id := hex.EncodeToString(hash[:])
 
 	return &Group{
@@ -223,7 +224,7 @@ func NewCheck(name string, group *Group) (*Check, error) {
 	}
 
 	path := group.Path + GroupSeparator + name
-	hash := md5.Sum([]byte(path)) //nolint:gosec
+	hash := sha256.Sum256([]byte(path)) //nolint:gosec
 	id := hex.EncodeToString(hash[:])
 
 	return &Check{
-- 
