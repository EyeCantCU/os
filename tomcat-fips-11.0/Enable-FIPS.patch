From 2d3b186b351d64cb251c0eb26d62af3b151ea619 Mon Sep 17 00:00:00 2001
From: Srishti Hegde <srishti.hegde@chainguard.dev>
Date: Mon, 10 Jun 2024 09:19:28 -0400
Subject: [PATCH] Enable FIPS

---
 conf/server.xml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/conf/server.xml b/conf/server.xml
index a5331fd048..44c685ae56 100644
--- a/conf/server.xml
+++ b/conf/server.xml
@@ -32,7 +32,7 @@
   <Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener" />
   <Listener className="org.apache.catalina.mbeans.GlobalResourcesLifecycleListener" />
   <Listener className="org.apache.catalina.core.ThreadLocalLeakPreventionListener" />
-
+  <Listener className="org.apache.catalina.core.AprLifecycleListener" SSLEngine="on" FIPSMode="on"></Listener>
   <!-- Global JNDI resources
        Documentation at /docs/jndi-resources-howto.html
   -->
