From: =?UTF-8?q?Arthur=20Exalta=C3=A7=C3=A3o?=
 <arthur.exaltacao@chainguard.dev>
Date: Mon, 28 Jul 2025 14:06:35 -0300
Subject: [PATCH] chore: dont require docker to build
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Signed-off-by: Arthur Exaltação <arthur.exaltacao@chainguard.dev>
---
 CMakeLists.txt | 9 +--------
 1 file changed, 1 insertion(+), 8 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index be8ce9c..07f8789 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -60,15 +60,9 @@ if(NOT CMAKE_BUILD_TYPE)
   set(CMAKE_BUILD_TYPE Release)
 endif()
 
-if(NOT TRITON_BUILD_OPENVINO_VERSION)
+if(FALSE)
   message(FATAL_ERROR "TRITON_BUILD_OPENVINO_VERSION is required")
-endif()
-
-if(WIN32 AND NOT TRITON_BUILD_CONTAINER)
   message(FATAL_ERROR "TRITON_BUILD_CONTAINER is required")
-endif()
-
-if(NOT TRITON_BUILD_CONTAINER AND NOT TRITON_BUILD_CONTAINER_VERSION)
   message(FATAL_ERROR
     "TRITON_BUILD_CONTAINER or TRITON_BUILD_CONTAINER_VERSION is required")
 endif()
@@ -199,7 +193,6 @@ if (WIN32)
     COMMAND docker rm openvino_backend_ov
     COMMENT "Building OpenVino"
   )
-else()
   add_custom_command(
     OUTPUT
       openvino/lib/${OPENVINO_LIBRARY}
-- 
2.50.1

